NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://ronan:ronan_dev@localhost:5435/ronan?schema=public

JWT_SECRET=change-me-dev
JWT_REFRESH_SECRET=change-me-dev-refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=90d

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=ronan
MINIO_SECRET_KEY=ronan_dev_secret
MINIO_BUCKET=ronan-tickets

VIACEP_URL=https://viacep.com.br/ws

# Roteamento. OSRM = km de faturamento (rota carga→descarga). VALHALLA = guia de
# navegação ao vivo (voz turn-by-turn pt-BR) do app. Ambos self-hosted no Easypanel.
# Sem eles setados, os endpoints de rota/navegação respondem "servidor não configurado".
OSRM_URL=
VALHALLA_URL=

# Google Places API (autocomplete de endereços com POIs)
# Console: https://console.cloud.google.com/ → ativar "Places API (New)"
# Configure quota diária + budget alert ($10/mês) pra não estourar custo
GOOGLE_MAPS_KEY=

CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Anthropic — OCR de ticket, match do fechamento e o conferente automático.
# Sem ela, o OCR do app responde 503 e o conferente não consome a fila.
# Console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# MiniMax — fornecedor alternativo pra LEITURA DE TICKET, em avaliação.
#
# A API deles é compatível com a da Anthropic, então é o mesmo SDK: o que muda é
# a chave e a base URL. Vale só pro conferente (fila assíncrona), escolhido por
# empresa em /configuracoes/ia. O OCR que o motorista espera na estrada continua
# no Claude.
#
# Preço do MiniMax-M3 (o único deles que enxerga imagem): US$ 0,30/MTok de
# entrada e US$ 1,20 de saída, contra US$ 1,00/US$ 5,00 do Haiku.
# Console: https://platform.minimax.io/
MINIMAX_API_KEY=
# Só pra apontar pro endpoint da China (api.minimaxi.com). Vazio = o global.
MINIMAX_BASE_URL=

# Conferência de ticket — o worker que lê a foto e compara com o lançamento.
# Nasce em MODO SOMBRA: grava o veredito e NÃO mexe na viagem. Sair disso é
# decisão consciente, depois de olhar alguns dias de veredito.
# CONFERENCIA_TICKET_ATIVA=true
# CONFERENCIA_MODO_SOMBRA=true
# Modelo da 1ª leitura. A empresa pode sobrescrever em /configuracoes/ia.
# CONFERENCIA_MODELO=claude-haiku-4-5-20251001
# Segunda opinião quando a leitura é fraca ou o peso diverge. Vazio desliga.
# CONFERENCIA_MODELO_2A_OPINIAO=claude-opus-5
#
# Aprovar sozinho a viagem que confere (nasce desligado — é a ação de maior
# raio de dano: ninguém revisa o que já está aprovado).
# CONFERENCIA_AUTO_APROVAR=false
# CONFERENCIA_CONFIANCA_APROVAR=0.9
# CONFERENCIA_MIN_CAMPOS_APROVAR=3
# Além do papel, a VIAGEM tem que fechar: km no padrão do trajeto e, se a rota
# passa por praça, valor de pedágio lançado e perto da média do par de locais.
# CONFERENCIA_APROVAR_EXIGE_KM_PADRAO=true
# CONFERENCIA_APROVAR_EXIGE_PEDAGIO=true
# CONFERENCIA_PEDAGIO_DESVIO_PCT=40
# CONFERENCIA_PEDAGIO_AMOSTRA_MIN=3
# CONFERENCIA_PEDAGIO_JANELA_DIAS=180

# OpenAI Whisper — transcrição de áudios do WhatsApp (motorista que prefere mandar áudio)
# Custo: ~USD 0.003-0.006/min. Sem essa key, áudios viram resposta amigável "manda de novo".
# Console: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Expo Push — recomendado em produção pra rate limits maiores e visibilidade
# Token gerado em https://expo.dev/accounts/[account]/settings/access-tokens
# Sem essa key, Expo aceita push anônima com limites menores (ok pra dev).
EXPO_ACCESS_TOKEN=

# Segredo do gatilho de "saiu versão nova" (POST /app/deploy/nova-versao).
# O comando de publicar OTA chama esse endpoint com header x-deploy-secret pra
# avisar os motoristas por push. Sem valor setado, o endpoint fica desligado (401).
DEPLOY_NOTIFY_SECRET=

# Base pública do painel (sem barra no fim) — usada pra montar o link do
# comprovante compartilhado: PUBLIC_APP_URL/v/<token>.
# Runtime de propósito: se fosse NEXT_PUBLIC_* no dashboard, mudar exigiria
# rebuild da imagem. Ausente = links saem apontando pra localhost (warn no boot).
PUBLIC_APP_URL=http://localhost:3001
