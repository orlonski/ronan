generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelEmpresa {
  RECEBE_PLANILHA
  MANDA_FECHAMENTO
  AMBOS
}

enum TipoLocal {
  CARGA
  DESCARGA
  AMBOS
}

enum StatusViagem {
  RASCUNHO_OFFLINE
  ENVIADA
  EM_CONFERENCIA
  DIVERGENTE
  AJUSTADA
  OK
  /// Viagem aberta pelo lifecycle guiado ("Iniciar viagem"): motorista ainda
  /// está rodando. Campos como material/toneladas/km/ticket/localDescarga podem
  /// estar nulos até o finalizar. NUNCA entra em match/fechamento/KPIs/resumos
  /// (filtrada explicitamente). Ao finalizar, transita pra ENVIADA.
  EM_ANDAMENTO
  /// Viagem lançada sem peso (toneladas) e ticket/romaneio — o motorista só terá
  /// o romaneio no fim do dia. Visível pro admin mas NUNCA entra em
  /// match/fechamento/KPIs/resumos/export enquanto incompleta. Vira ENVIADA
  /// quando o motorista (app) ou o admin (dashboard) completa peso + ticket.
  AGUARDANDO_PESO
}

enum TipoDivergencia {
  /// Admin marcou divergente pq motorista nao preencheu valor de pedagio
  /// mas a rota passa por pedagio cadastrado. App motorista mostra card
  /// dedicado pedindo so o valor.
  PEDAGIO_SEM_VALOR
  /// Foto do ticket nao da pra ler. App motorista mostra card com botao
  /// de tirar nova foto. Fotos antigas continuam no historico.
  FOTO_ILEGIVEL
  /// Km lancado parece divergir do trajeto. App motorista mostra card com o
  /// motivo do admin + campo pra corrigir o km e justificar (vai pra observacao).
  KM_DIVERGENTE
  /// Qualquer outro motivo. Motorista corrige editando a viagem normal.
  OUTRO
}

enum FonteFechamento {
  UPLOAD
  MANUAL
  EMAIL
}

enum StatusFechamento {
  RECEBIDO
  EM_PROCESSAMENTO
  AGUARDANDO_REVISAO
  CONFERIDO
  EXPORTADO
  SUBSTITUIDO
  // valores legados (não usar em código novo, mantidos pra compat de migração)
  EM_CONCILIACAO
  CONCLUIDO
}

enum StatusLinhaFechamento {
  MATCH
  MATCH_IA
  DIVERGENCIA
  FALTANDO
  EXTRA
  RESOLVIDA_OPERADORA
}

enum StatusEnvio {
  GERADO
  ENVIADO
}

enum AcaoAuditoria {
  UPDATE
  DELETE
  RESOLVER
  SUBSTITUIR
  EXPORTAR
  MARCAR_ENVIADO
  MATCH_AUTOMATICO
  MATCH_IA
  RECALCULAR_TRAJETO
  MOTORISTA_AJUSTOU_KM
  MOTORISTA_JUSTIFICOU_KM
  MOTORISTA_INFORMOU_PEDAGIO
  MOTORISTA_SUBSTITUIU_FOTO
  PRE_VALIDAR_VIAGEM
  ADICIONAR_FOTO
  MESCLAR_LOCAL
  COMPARTILHAR_VIAGEM
  REVOGAR_COMPARTILHAMENTO
  ENVIAR_COMPARTILHAMENTO
}

enum TipoCombustivel {
  DIESEL_S10
  DIESEL_S500
  ARLA_32
  GASOLINA
  ETANOL
}

/// Nível de confiança de um Local cadastrado. Sobe sozinho conforme evidências
/// (GPS pontual, dwell por tracking ativo, dwell por geofence passivo,
/// recorrência) ou aprovação manual do admin.
enum NivelConfiancaLocal {
  RASCUNHO
  PRESENCA_PONTUAL
  DWELL_CONFIRMADO
  RECORRENTE
  HUMANO
}

/// Origem de cada evidência registrada em LocalEvidencia.
enum FonteEvidencia {
  GPS_REGISTRO
  TRACKING_DWELL
  GEOFENCE_PASSIVO
  RECORRENCIA
  ADMIN
}

/// De qual fluxo o Local nasceu. null = cadastrado antes do rastreio existir
/// (dados antigos, não dá pra inferir sem inventar).
enum OrigemCadastroLocal {
  /// Motorista preencheu o formulário completo de endereço no app.
  MOTORISTA_FORMULARIO
  /// Motorista digitou só o nome + GPS; backend completou via reverse geocoding.
  MOTORISTA_RAPIDO
  /// Recriado no servidor ao sincronizar viagem offline cujo local sumiu.
  VIAGEM_OFFLINE
  /// Admin cadastrou manualmente pelo dashboard.
  ADMIN_MANUAL
  /// Admin cadastrou na auditoria de uma viagem (local de descarga pelo GPS).
  ADMIN_AUDITORIA
}

/// Fonte do sinal de GPS no momento da captura (viagem/local). Gravado pra
/// auditar: PRECISA = fix de alta precisão (bom); BALANCED = fix mais leve
/// (aceitável); CACHE = posição em cache do sistema (last-known, pode estar
/// defasada — o motorista estava sem sinal e caiu no fallback). null = PWA
/// (browser não distingue), admin, ou registro antigo pré-feature.
enum FonteGps {
  PRECISA
  BALANCED
  CACHE
}

/// Tipos fixos de anexo que admin guarda por motorista (CNH, CRLV, seguro,
/// ASO, EPIs, eSocial, NR, OS, registro, comodato, laudo, plano de
/// manutenção). 1 arquivo por tipo — reupload substitui o anterior.
enum TipoDocumentoMotorista {
  CNH
  CRLV
  SEGURO_VEICULO
  REGISTRO_MOTORISTA
  ASO
  EPI
  ESOCIAL
  NR
  OS
  COMODATO
  LAUDO_TECNICO
  PLANO_MANUTENCAO
}

/// Tipo de bloco de uma planilha de fechamento. Cada empresa pode ter
/// blocos de múltiplos tipos configurados (LayoutImportBloco) e cada
/// FechamentoLinha gerada herda o tipo do bloco que a originou.
enum TipoBlocoFechamento {
  VIAGEM
  PEDAGIO
  COMBUSTIVEL
}

/// Conta = a empresa que assina o sistema. É o tenant: todo dado de negócio
/// pertence a exatamente uma conta, e o isolamento é garantido pela trava
/// automática em `common/conta/trava-conta.ts` — não por filtro manual em cada
/// consulta.
///
/// NÃO confundir com `Empresa` (o tomador de serviço, quem manda planilha de
/// fechamento) nem com `Transportadora` (a frota dona dos caminhões, que é um
/// sub-escopo DENTRO de uma conta).
///
/// Sobre o `@default("__SEM_CONTA__")` que todo `contaId` carrega: quem preenche
/// o campo de verdade é a trava, em toda operação do Prisma. O default existe só
/// pra que o TypeScript não exija `contaId` nos ~150 `create` espalhados pelo
/// código — exigir levaria o contaId a ser carregado na mão service a service,
/// que é justamente o erro que a trava evita. O valor é proposital: não existe
/// conta com esse id, então um insert que escape da trava morre na chave
/// estrangeira em vez de gravar dado sem dono.
model Conta {
  id                  String   @id @default(uuid())
  /// Nome comercial, aparece no painel e nas mensagens de WhatsApp.
  nome                String
  /// Identificador curto e estável (lowercase, sem espaço). Vai ser a chave da
  /// landing/subdomínio quando o auto-cadastro entrar.
  slug                String   @unique
  cnpj                String?  @unique
  ativa               Boolean  @default(true)
  /// Código que o motorista digita no app pra dizer de qual empresa ele é.
  /// Direciona o cadastro, NÃO autoriza: o motorista continua entrando como
  /// PENDENTE_APROVACAO e é a empresa que decide. Por isso código vazado não é
  /// incidente — no máximo um cadastro pra recusar. Trocável pelo painel.
  codigoConvite       String?  @unique
  /// Se o auto-cadastro de motorista (signup pelo app) cai nesta conta.
  /// O app publicado nas lojas não diz de qual empresa o motorista é, então
  /// alguém precisa ser o destino padrão. Com mais de uma conta marcada, o
  /// signup passa a exigir o `contaSlug` no formulário.
  permiteAutoCadastro Boolean  @default(false)
  /// URL pública servida por /publico/contas/:id/logo (com `v` pra furar cache).
  logoUrl             String?
  /// Chave do objeto no MinIO. Separada da URL pra poder apagar a logo antiga.
  logoKey             String?
  corPrimaria         String?
  criadaEm            DateTime @default(now())
  alteradaEm          DateTime @updatedAt

  users                         User[]
  papeis                        Papel[]
  adminNotificacoes             AdminNotificacao[]
  motoristas                    Motorista[]
  cadastrosMotoristaPendentes   CadastroMotoristaPendente[]
  redefinicoesSenhaPendentes    RedefinicaoSenhaPendente[]
  motoristaPosicaoConfigs       MotoristaPosicaoConfig[]
  motoristaPosicoes             MotoristaPosicao[]
  motoristaDocumentos           MotoristaDocumento[]
  motoristaVeiculos             MotoristaVeiculo[]
  whatsappSessoes               WhatsappSessao[]
  whatsappConvites              WhatsappConvite[]
  whatsappMensagens             WhatsappMensagem[]
  veiculos                      Veiculo[]
  transportadoras               Transportadora[]
  usuarioTransportadoras        UsuarioTransportadora[]
  empresas                      Empresa[]
  layoutImportBlocos            LayoutImportBloco[]
  clientes                      Cliente[]
  materiais                     Material[]
  regrasMinimo                  RegraMinimo[]
  locais                        Local[]
  locaisClientes                LocalCliente[]
  locaisEvidencias              LocalEvidencia[]
  viagens                       Viagem[]
  trechosViagem                 TrechoViagem[]
  tiposEventoViagem             TipoEventoViagem[]
  eventosViagem                 EventoViagem[]
  viagensMensagens              ViagemMensagem[]
  ticketFotos                   TicketFoto[]
  viagensCompartilhamentos      ViagemCompartilhamento[]
  stories                       Story[]
  storyVisualizacoes            StoryVisualizacao[]
  storyReacoes                  StoryReacao[]
  viagensPontos                 ViagemPonto[]
  pedagios                      Pedagio[]
  fechamentos                   Fechamento[]
  fechamentoLinhas              FechamentoLinha[]
  layoutsEnvio                  LayoutEnvio[]
  enviosFechamento              EnvioFechamento[]
  auditLogs                     AuditLog[]
  configuracoesTracking         ConfiguracaoTracking[]
  configuracoesIa               ConfiguracaoIa[]
  configuracoesAgente           ConfiguracaoAgente[]
  configuracoesAvisoGrupo       ConfiguracaoAvisoGrupo[]
  configuracoesBuscaLocais      ConfiguracaoBuscaLocais[]
  configuracoesKmAtipico        ConfiguracaoKmAtipico[]
  configuracoesForcaAtualizacao ConfiguracaoForcaAtualizacao[]
  camposLayout                  CampoLayout[]
  errorLogs                     ErrorLog[]
  lancamentosResgatados         LancamentoResgatado[]
  eventosMotorista              EventoMotorista[]
  abastecimentos                Abastecimento[]
  abastecimentoFotos            AbastecimentoFoto[]
  notificacoes                  Notificacao[]
  conversas                     Conversa[]
  conversaParticipantes         ConversaParticipante[]
  mensagensChat                 MensagemChat[]
  bloqueiosChat                 BloqueioChat[]
  denunciasMensagemChat         DenunciaMensagemChat[]

  @@index([ativa])
  @@map("contas")
}

model User {
  contaId             String    @default("__SEM_CONTA__")
  conta               Conta     @relation(fields: [contaId], references: [id])
  id                  String    @id @default(uuid())
  nome                String
  email               String    @unique
  senhaHash           String
  ativo               Boolean   @default(true)
  ultimoLoginEm       DateTime?
  // Resumo diário no WhatsApp: número (normalizado com DDI) e opt-in.
  whatsappResumo      String?
  receberResumoDiario Boolean   @default(false)
  // Assuntos do resumo que ESTE usuário recebe (preferência pessoal, não papel).
  // Vazio = trata como "todos" no envio. Ids em @ronan/shared-types ASSUNTOS_RESUMO.
  resumoAssuntos      String[]  @default([])
  // Papel (RBAC): define as permissões granulares (telas, assuntos do resumo).
  // O papel diz O QUE o usuário pode fazer; o escopo abaixo diz QUAIS registros
  // ele enxerga. São dimensões independentes.
  papel               Papel?    @relation(fields: [papelId], references: [id], onDelete: SetNull)
  papelId             String?
  /// True = enxerga todos os registros (comportamento histórico; migration seta
  /// true pra todo mundo que já existia). False = restrito às transportadoras
  /// vinculadas em `transportadoras` — e restrito SEM vínculo nenhum não vê
  /// nada, nunca tudo. Fail-open aqui liberaria a base inteira por esquecimento.
  acessoGlobal        Boolean   @default(true)
  /// True = operador da PLATAFORMA (o dono do sistema), não da conta. É o único
  /// que enxerga a tela de contas e pode criar empresa nova. Não é "vê tudo de
  /// todo mundo": pra dar suporte ele entra numa conta por impersonação
  /// explícita, que fica registrada no AuditLog.
  plataforma          Boolean   @default(false)
  criadoEm            DateTime  @default(now())
  alteradoEm          DateTime  @updatedAt

  resolucoes                 FechamentoLinha[]
  envios                     EnvioFechamento[]
  auditorias                 AuditLog[]
  resgatesResolvidos         LancamentoResgatado[]
  layoutsEnvio               LayoutEnvio[]
  configsTracking            ConfiguracaoTracking[]
  configsIa                  ConfiguracaoIa[]
  configsAgente              ConfiguracaoAgente[]
  configsBuscaLocais         ConfiguracaoBuscaLocais[]
  configsAvisoGrupo          ConfiguracaoAvisoGrupo[]
  configsForcaAtualizacao    ConfiguracaoForcaAtualizacao[]
  configsKmAtipico           ConfiguracaoKmAtipico[]
  mensagensViagem            ViagemMensagem[]               @relation("MensagensViagem")
  mensagensChat              MensagemChat[]                 @relation("MensagensChat")
  mensagensChatRemovidas     MensagemChat[]                 @relation("RemoveuMensagemChat")
  denunciasChatResolvidas    DenunciaMensagemChat[]         @relation("ResolveuDenunciaChat")
  whatsappSessao             WhatsappSessao?
  whatsappConvites           WhatsappConvite[]
  compartilhamentosCriados   ViagemCompartilhamento[]       @relation("CompartilhouViagem")
  compartilhamentosRevogados ViagemCompartilhamento[]       @relation("RevogouCompartilhamento")

  // Backreferences pra rastreamento "Cadastrado por": cada recurso admin
  // tem `criadoPorId` opcional → User. Listas inversas necessárias pelo Prisma.
  // Escopo de acesso (ver acessoGlobal). Vazio + acessoGlobal=false = vê nada.
  transportadoras UsuarioTransportadora[]

  clientesCriados        Cliente[]          @relation("CriouCliente")
  materiaisCriados       Material[]         @relation("CriouMaterial")
  veiculosCriados        Veiculo[]          @relation("CriouVeiculo")
  transportadorasCriadas Transportadora[]   @relation("CriouTransportadora")
  motoristasCriados      Motorista[]        @relation("CriouMotorista")
  motoristasAprovados    Motorista[]        @relation("AprovouMotorista")
  empresasCriadas        Empresa[]          @relation("CriouEmpresa")
  regrasMinimoCriadas    RegraMinimo[]      @relation("CriouRegraMinimo")
  tiposEventoCriados     TipoEventoViagem[] @relation("CriouTipoEventoViagem")
  locaisCriados          Local[]            @relation("CriouLocal")
  usuariosCriados        User[]             @relation("CriouUser")
  criadoPor              User?              @relation("CriouUser", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoPorId            String?
  notificacoesCriadas    Notificacao[]      @relation("CriouNotificacao")
  fechamentosCriados     Fechamento[]       @relation("CriouFechamento")
  viagensRevisadas       Viagem[]           @relation("RevisouViagem")
  adminNotificacoes      AdminNotificacao[]

  @@index([contaId])
  @@map("users")
}

/// Catálogo de permissões liberáveis (RBAC). Semeado no boot (sistema=true) —
/// cada chave é referenciada pelo código (telas, blocos do resumo). A liberação
/// (quem tem) vive nos papéis; este catálogo só descreve o que existe pra a UI.
model Permissao {
  chave     String  @id // ex: "tela.viagens", "resumo.producao"
  modulo    String // agrupador na UI: "Telas", "Resumo diário"
  titulo    String
  descricao String?
  ordem     Int     @default(100)
  sistema   Boolean @default(true)

  @@index([modulo, ordem])
  @@map("permissoes")
}

/// Papel (RBAC): conjunto nomeado de permissões. `permissoes` guarda as chaves
/// liberadas. `sistema=true` nos embutidos (Administrador/Operador).
model Papel {
  contaId    String   @default("__SEM_CONTA__")
  conta      Conta    @relation(fields: [contaId], references: [id])
  id         String   @id @default(uuid())
  nome       String
  descricao  String?
  permissoes String[] @default([])
  sistema    Boolean  @default(false)
  criadoEm   DateTime @default(now())
  alteradoEm DateTime @updatedAt

  usuarios User[]

  @@unique([contaId, nome])
  @@index([contaId])
  @@map("papeis")
}

/// Caixa de entrada do admin no dashboard. Sininho no topo le esta tabela.
/// Cada evento relevante (motorista lancou viagem, respondeu divergencia, etc)
/// gera 1 linha por admin/operador ativo (fan-out na criacao). Admin marca
/// como lida individualmente sem afetar os outros.
model AdminNotificacao {
  contaId   String    @default("__SEM_CONTA__")
  conta     Conta     @relation(fields: [contaId], references: [id])
  id        String    @id @default(uuid())
  usuario   User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  /// Tipo do evento: "nova-viagem" | "resposta-divergencia-pedagio" |
  /// "resposta-divergencia-foto" | "foto-anexada" | "local-em-validacao".
  /// String pra poder evoluir sem migration.
  tipo      String
  titulo    String
  corpo     String
  /// JSON com IDs auxiliares pra UI navegar (viagemId, motoristaId, localId).
  dados     Json?
  lida      Boolean   @default(false)
  lidaEm    DateTime?
  criadoEm  DateTime  @default(now())

  @@index([usuarioId, lida, criadoEm])
  @@index([criadoEm])
  @@index([contaId])
  @@map("admin_notificacoes")
}

/// Ciclo de aprovação do cadastro do motorista.
/// PENDENTE_APROVACAO: auto-cadastro recém-criado, aguardando admin validar.
/// APROVADO: pode usar o app normalmente (criados pelo admin nascem aqui).
/// REJEITADO: cadastro recusado — não consegue logar.
enum StatusMotorista {
  PENDENTE_APROVACAO
  APROVADO
  REJEITADO
}

model Motorista {
  contaId                 String          @default("__SEM_CONTA__")
  conta                   Conta           @relation(fields: [contaId], references: [id])
  id                      String          @id @default(uuid())
  nome                    String
  cpf                     String // 11 dígitos (sem máscara) — também é o login
  senhaHash               String
  telefone                String?
  email                   String?
  veiculoDefault          Veiculo?        @relation("VeiculoDefaultMotorista", fields: [veiculoDefaultId], references: [id])
  veiculoDefaultId        String?
  // Status de aprovação do cadastro. Default APROVADO pra não quebrar fluxo
  // existente (admin cria já aprovado; migration seta existentes pra APROVADO).
  // Auto-cadastro pelo app nasce PENDENTE_APROVACAO.
  status                  StatusMotorista @default(APROVADO)
  aprovadoEm              DateTime?
  aprovadoPor             User?           @relation("AprovouMotorista", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  aprovadoPorId           String?
  ativo                   Boolean         @default(true)
  ultimoLoginEm           DateTime?
  tentativasLogin         Int             @default(0)
  bloqueadoAte            DateTime?
  expoPushToken           String?
  pushTokenAtualizadoEm   DateTime?
  // Preferências de recebimento (o motorista controla no app). Default true pra
  // não silenciar ninguém sem escolha. aceitaPush gateia o PushService (choke
  // central); aceitaWhatsapp gateia os avisos por WhatsApp (não o código de
  // cadastro, que é de autenticação).
  aceitaPush              Boolean         @default(true)
  aceitaWhatsapp          Boolean         @default(true)
  // Resumo diário do dia no WhatsApp (cron 20h). Gate próprio além do
  // aceitaWhatsapp mestre — o motorista pode querer os avisos mas não o resumo.
  receberResumoDiario     Boolean         @default(true)
  // Versão do app que o motorista está rodando — capturada via headers em
  // toda request pelo AppVersionInterceptor. Como o runtimeVersion usa policy
  // "appVersion", o appVersion sozinho NÃO muda entre updates OTA; o que
  // identifica o código real é o appUpdateId / appBuiltAt (bundle EAS Update).
  appVersion              String? // ex: "1.2.0" (Constants.expoConfig.version)
  appPlatform             String? // "ios" | "android" (Platform.OS) — força-atualização
  appUpdateId             String? // id do bundle OTA rodando (Updates.updateId)
  appBuiltAt              DateTime? // quando o bundle foi publicado (Updates.createdAt)
  appCanal                String? // canal EAS Update (ex: "production")
  appVistoEm              DateTime? // última vez que o app reportou versão (= visto online)
  // Quando o aviso "fulano entrou no app" foi postado no grupo do WhatsApp.
  // Trava de envio único: uma vez setado, nunca reanuncia esse motorista.
  avisoGrupoEnviadoEm     DateTime?
  // Acessos por funcionalidade (controle de feature flag por motorista).
  // Default false nos campos sensíveis = novo motorista nasce travado e o admin
  // libera caso a caso pelo dashboard. podeLancarViagem/podeLancarAbastecimento
  // seguem true pra não quebrar fluxo existente.
  podeLancarViagem        Boolean         @default(true)
  podeIniciarViagem       Boolean         @default(false)
  /// Lifecycle guiado de viagem (Iniciar → eventos → Finalizar), com viagem
  /// criada no backend já no início (status EM_ANDAMENTO). Flag separada de
  /// podeIniciarViagem (tracking GPS efêmero legado) pra rodar os dois modos
  /// em paralelo durante a transição.
  podeViagemLifecycle     Boolean         @default(false)
  podeLancarPedagio       Boolean         @default(false)
  podeLancarAbastecimento Boolean         @default(true)
  /// Quando true, o app dispara OCR via IA na foto do ticket pra sugerir
  /// preenchimento. False = motorista preenche tudo manualmente.
  podeUsarOcrTicket       Boolean         @default(false)
  /// Stories (estilo Instagram): vê a barra na home, posta e reage. Liberado
  /// pra todos (default true); admin pode desligar caso a caso pelo dashboard.
  podeVerStories          Boolean         @default(true)
  /// Quando true, o app mostra "Buscar local por nome" na descarga (lista todos
  /// os locais, não só os do GPS por perto). Default false — admin libera caso a
  /// caso (ex: desenvolvedor testando). Só affordance de UI: o catálogo já traz tudo.
  podeVerTodosLocais      Boolean         @default(false)
  /// Referência de km por trajeto: ao escolher carga+descarga, o app mostra o que
  /// a frota já rodou nesse par ("7 viagens, quase sempre ~100 km") com um toque
  /// pra usar o valor; e avisa/pede justificativa se o km sair fora do padrão.
  /// Só UX do app — o backend carimba kmForaDoPadrao pra todo mundo independente
  /// desta flag, e o lançamento nunca é bloqueado. Rollout gradual: default false.
  podeReferenciaKm        Boolean         @default(false)
  /// Telemetria de interação na tela "Nova viagem" (o que clicou/buscou/selecionou,
  /// o que a lista trouxe) — pra diagnosticar ex. "descarga errada". Opt-in por
  /// motorista; gate é client-side (só emite os eventos nv_*). Default false.
  podeTelemetria          Boolean         @default(false)
  /// Chat entre motoristas (aba Conversas). Default TRUE: validado em campo e
  /// liberado pra todo mundo — motorista novo já nasce com a aba. Continua
  /// desligável caso a caso pelo painel (ex: alguém que abusou); desligar
  /// remove a aba e bloqueia /m/chat/*, mas as conversas ficam guardadas.
  podeChat                Boolean         @default(true)
  /// Frota dona do motorista. Null = não classificado (invisível pros usuários
  /// restritos). Usado pra carimbar Viagem/Pedagio/Abastecimento na criação —
  /// mudar aqui NÃO reescreve o histórico já carimbado, de propósito.
  transportadora          Transportadora? @relation(fields: [transportadoraId], references: [id], onDelete: SetNull)
  transportadoraId        String?
  criadoEm                DateTime        @default(now())
  alteradoEm              DateTime        @updatedAt

  viagens               Viagem[]
  pedagios              Pedagio[]
  abastecimentos        Abastecimento[]
  veiculos              MotoristaVeiculo[]
  documentos            MotoristaDocumento[]
  locaisCriados         Local[]                   @relation("LocalCriadoPor")
  evidenciasLocal       LocalEvidencia[]
  whatsappSessao        WhatsappSessao?
  whatsappConvites      WhatsappConvite[]
  notificacoes          Notificacao[]
  eventos               EventoMotorista[]
  mensagensViagem       ViagemMensagem[]          @relation("MensagensViagem")
  mensagensChat         MensagemChat[]            @relation("MensagensChat")
  participacoesChat     ConversaParticipante[]    @relation("ParticipacoesChat")
  bloqueiosFeitos       BloqueioChat[]            @relation("BloqueiosFeitos")
  bloqueiosRecebidos    BloqueioChat[]            @relation("BloqueiosRecebidos")
  denunciasChat         DenunciaMensagemChat[]    @relation("DenunciasChat")
  posicaoConfig         MotoristaPosicaoConfig?
  posicoes              MotoristaPosicao[]
  stories               Story[]
  lancamentosResgatados LancamentoResgatado[]
  storyVisualizacoes    StoryVisualizacao[]
  storyReacoes          StoryReacao[]
  redefinicaoSenha      RedefinicaoSenhaPendente?
  criadoPor             User?                     @relation("CriouMotorista", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoPorId           String?

  @@unique([contaId, cpf])
  @@index([ativo])
  @@index([status])
  @@index([transportadoraId])
  @@index([contaId])
  @@index([contaId, ativo])
  @@index([contaId, status])
  @@map("motoristas")
}

/// Cadastro de motorista iniciado pelo app, aguardando verificação do código
/// enviado por WhatsApp. Guarda os dados do formulário (com senha já hasheada)
/// antes do Motorista existir; vira Motorista ao confirmar o código e é apagado.
/// Espelha o padrão de WhatsappConvite (código curto + expiração).
model CadastroMotoristaPendente {
  contaId       String   @default("__SEM_CONTA__")
  conta         Conta    @relation(fields: [contaId], references: [id])
  id            String   @id @default(uuid())
  cpf           String // 11 dígitos (sem máscara) — chave do cadastro
  nome          String
  telefone      String // celular onde o código é enviado
  email         String?
  senhaHash     String
  /// Lista de placas do formulário: { placa, modelo?, default }
  placas        Json
  codigo        String // 6 dígitos numéricos
  expiraEm      DateTime
  tentativas    Int      @default(0) // confirmações erradas
  reenvios      Int      @default(0)
  ultimoEnvioEm DateTime @default(now())
  criadoEm      DateTime @default(now())

  @@unique([contaId, cpf])
  @@index([contaId])
  @@map("cadastros_motorista_pendentes")
}

/// Pedido de redefinição de senha do motorista verificado por código no
/// WhatsApp (fluxo "esqueci minha senha"). Chave por motorista (1 pendente por
/// vez). Curto prazo: criado no "esqueci", apagado ao redefinir/expirar.
model RedefinicaoSenhaPendente {
  contaId       String    @default("__SEM_CONTA__")
  conta         Conta     @relation(fields: [contaId], references: [id])
  id            String    @id @default(uuid())
  motoristaId   String    @unique
  motorista     Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  /// Número de destino do código (já normalizado pra dígitos com DDD).
  telefone      String
  /// Quando true, o telefone acima deve ser GRAVADO no cadastro do motorista
  /// após a confirmação (caso de motorista que não tinha celular cadastrado).
  vincular      Boolean   @default(false)
  codigo        String // 6 dígitos numéricos
  expiraEm      DateTime
  tentativas    Int       @default(0) // confirmações erradas
  reenvios      Int       @default(0)
  ultimoEnvioEm DateTime  @default(now())
  criadoEm      DateTime  @default(now())

  @@index([contaId])
  @@map("redefinicoes_senha_pendentes")
}

/// Preferências do motorista pra compartilhamento de posição periódica
/// (controle de frota). Opt-in: motorista decide se quer participar e em
/// qual janela horária. 1:1 com Motorista.
model MotoristaPosicaoConfig {
  contaId       String    @default("__SEM_CONTA__")
  conta         Conta     @relation(fields: [contaId], references: [id])
  motoristaId   String    @id
  motorista     Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  /// Master toggle. Default false — motorista escolhe explicitamente ativar.
  ativada       Boolean   @default(false)
  /// Janela horária em hora LOCAL (Brasil). null/null = 24/7. Ex: 8/18 = das 8h às 18h.
  horarioInicio Int?
  horarioFim    Int?
  alteradoEm    DateTime  @updatedAt

  @@index([contaId])
  @@map("motorista_posicao_config")
}

/// Pedágio em rodovia (cadastro permanente da praça física).
/// IMPORTANTE: diferente do model `Pedagio` mais abaixo, que é o lançamento
/// de DESPESA que o motorista registra por viagem. Esse aqui é a praça em
/// si — coordenada GPS + valor base — usada pra detectar quais pedágios
/// uma rota carga→descarga atravessa (haversine ponto vs polyline OSRM
/// cacheada). Cadastro manual ou importado do OpenStreetMap.
model PedagioRodovia {
  id             String   @id @default(uuid())
  nome           String // ex: "Praça Reg. Norte BR-376 Ponta Grossa"
  concessionaria String? // ex: "Arteris", "CCR ViaSul"
  rodovia        String? // ex: "BR-376"
  cidade         String?
  uf             String? // sigla (2 chars)
  lat            Float
  lng            Float
  /// Valor base por eixo simples em R$. Caminhão com N eixos = valorBase * N.
  /// Null se ainda não cadastrado (vem da importação OSM sem valor).
  valorBase      Decimal? @db.Decimal(8, 2)
  ativo          Boolean  @default(true)
  /// Origem do registro: "osm" (importado do OpenStreetMap) ou "manual".
  fonte          String   @default("manual")
  /// ID original do OSM pra dedup em re-importação. Null pra cadastros manuais.
  osmId          String?  @unique
  criadoEm       DateTime @default(now())
  alteradoEm     DateTime @updatedAt

  // Bounding-box pré-filtro: a app calcula menor distância ponto-segmento
  // só pros pedágios cujo lat/lng cabe num envelope da rota. Sem índice
  // espacial dedicado (sem PostGIS) — índices simples cobrem o volume
  // esperado (~poucas centenas de pedágios no BR).
  @@index([lat, lng])
  @@index([uf])
  @@index([ativo])
  @@map("pedagios_rodovia")
}

/// Histórico append-only de posições GPS do motorista capturadas via task
/// periódica em background (a cada ~15min, configurável). Diferente de
/// ViagemPonto que é tracking granular durante viagem ativa. TTL = 90d
/// (job de retenção no backend).
model MotoristaPosicao {
  contaId     String    @default("__SEM_CONTA__")
  conta       Conta     @relation(fields: [contaId], references: [id])
  id          String    @id @default(uuid())
  motoristaId String
  motorista   Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  lat         Float
  lng         Float
  precisao    Float?
  velocidade  Float?
  capturadoEm DateTime // timestamp do device
  recebidoEm  DateTime  @default(now())

  // Idempotência: motorista pode enviar a mesma posição 2x (retry sync). Único
  // composto evita duplicata exata sem precisar de id client-side.
  @@unique([motoristaId, capturadoEm])
  @@index([motoristaId, capturadoEm])
  @@index([capturadoEm])
  @@index([contaId])
  @@map("motorista_posicoes")
}

/// Anexo de documento por motorista (CNH, CRLV, seguro, ASO, etc).
/// 1 registro por (motoristaId, tipo) — substituição apaga o anterior.
/// `validade` é opcional (alguns docs não têm); status (válido/vencendo/vencido)
/// é derivado em runtime, não persistido. Arquivos ficam no MinIO sob a key.
model MotoristaDocumento {
  contaId     String                 @default("__SEM_CONTA__")
  conta       Conta                  @relation(fields: [contaId], references: [id])
  id          String                 @id @default(uuid())
  motoristaId String
  motorista   Motorista              @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  tipo        TipoDocumentoMotorista
  nomeArquivo String
  storageKey  String
  mimetype    String
  tamanho     Int
  validade    DateTime?              @db.Date
  criadoEm    DateTime               @default(now())
  alteradoEm  DateTime               @updatedAt

  @@unique([motoristaId, tipo])
  @@index([motoristaId])
  @@index([contaId])
  @@map("motorista_documento")
}

/// Vínculo N:N entre motorista e veículo. Placa é da empresa, pode ser
/// dirigida por vários motoristas (revezamento) e cada motorista pode
/// estar atrelado a múltiplas placas. Invariante: todo veículo precisa
/// de ≥ 1 motorista (aplicada no service, não em SQL).
model MotoristaVeiculo {
  contaId     String   @default("__SEM_CONTA__")
  conta       Conta    @relation(fields: [contaId], references: [id])
  motoristaId String
  veiculoId   String
  criadoEm    DateTime @default(now())

  motorista Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  veiculo   Veiculo   @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  @@id([motoristaId, veiculoId])
  @@index([veiculoId])
  @@index([contaId])
  @@map("motorista_veiculo")
}

/// Vincula 1 telefone WhatsApp a 1 motorista OU 1 admin user (mutuamente exclusivo).
/// Sessão por telefone — quem mandar mensagem desse número é identificado e roteado
/// pro toolset adequado (motorista lança viagem; admin consulta dashboard).
model WhatsappSessao {
  contaId        String             @default("__SEM_CONTA__")
  conta          Conta              @relation(fields: [contaId], references: [id])
  id             String             @id @default(uuid())
  /// Formato "5541999999999" (só dígitos, com DDI 55). Único DENTRO da conta,
  /// não no sistema: o motorista que roda pra duas empresas tem UM celular e
  /// precisa poder falar com as duas. Quem decide de qual empresa é a mensagem
  /// que chega é o cadastro que está com o aparelho (ver `resolverPorTelefone`).
  telefone       String
  motorista      Motorista?         @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  motoristaId    String?            @unique
  user           User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?            @unique
  vinculadoEm    DateTime           @default(now())
  ultimaMensagem DateTime?
  mensagens      WhatsappMensagem[]

  @@unique([contaId, telefone])
  @@index([contaId])
  @@index([telefone])
  @@map("whatsapp_sessoes")
}

/// Código curto (6 chars alfanuméricos) gerado pelo admin no painel pra autorizar
/// vinculação. Motorista cola no chat, sistema valida + cria sessão. Expira em 24h.
model WhatsappConvite {
  contaId     String     @default("__SEM_CONTA__")
  conta       Conta      @relation(fields: [contaId], references: [id])
  id          String     @id @default(uuid())
  codigo      String     @unique // ex: "A3F7K9" (uppercase, sem 0/O/1/I)
  motorista   Motorista? @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  motoristaId String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  expiraEm    DateTime
  usadoEm     DateTime?
  criadoEm    DateTime   @default(now())

  @@index([codigo])
  @@index([contaId])
  @@map("whatsapp_convites")
}

/// Histórico de mensagens recebidas/enviadas pelo bot. Usado pra auditoria E pra
/// montar contexto curto (últimas N) que vai pro Claude na próxima rodada.
model WhatsappMensagem {
  contaId  String          @default("__SEM_CONTA__")
  conta    Conta           @relation(fields: [contaId], references: [id])
  id       String          @id @default(uuid())
  sessao   WhatsappSessao? @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  sessaoId String?
  telefone String // sempre presente, mesmo sem sessão (fluxo inicial)
  direcao  String // "ENTRADA" | "SAIDA"
  conteudo String          @db.Text
  tipo     String // "TEXTO" | "IMAGEM" | "AUDIO"
  metadata Json? // { fotoStorageKey, viagemCriadaId, toolsChamadas, evolutionMsgId, ... }
  criadoEm DateTime        @default(now())

  @@index([telefone, criadoEm])
  @@index([sessaoId, criadoEm])
  @@index([contaId])
  @@map("whatsapp_mensagens")
}

model Veiculo {
  contaId          String          @default("__SEM_CONTA__")
  conta            Conta           @relation(fields: [contaId], references: [id])
  id               String          @id @default(uuid())
  placa            String
  modelo           String?
  ativo            Boolean         @default(true)
  /// Frota dona do caminhão. Null = não classificado. Serve de fallback quando
  /// o motorista não tem transportadora no momento do lançamento.
  transportadora   Transportadora? @relation(fields: [transportadoraId], references: [id], onDelete: SetNull)
  transportadoraId String?
  criadoEm         DateTime        @default(now())
  alteradoEm       DateTime        @updatedAt

  motoristasComoDefault Motorista[]        @relation("VeiculoDefaultMotorista")
  motoristas            MotoristaVeiculo[]
  viagens               Viagem[]
  pedagios              Pedagio[]
  abastecimentos        Abastecimento[]
  criadoPor             User?              @relation("CriouVeiculo", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoPorId           String?

  @@unique([contaId, placa])
  @@index([ativo])
  @@index([transportadoraId])
  @@index([contaId])
  @@index([contaId, ativo])
  @@map("veiculos")
}

/// Dona dos caminhões e dos motoristas — a frota. A Schaba é uma; as frotas
/// terceiras que rodam pra ela são outras. NÃO confundir com Empresa, que é o
/// tomador de serviço (quem manda planilha de fechamento / recebe viagem).
///
/// Existe pra dar escopo de acesso no painel: um usuário restrito a uma
/// transportadora só enxerga os lançamentos dela (ver UsuarioTransportadora).
model Transportadora {
  contaId    String   @default("__SEM_CONTA__")
  conta      Conta    @relation(fields: [contaId], references: [id])
  id         String   @id @default(uuid())
  nome       String
  cnpj       String?
  contato    String?
  ativa      Boolean  @default(true)
  criadoEm   DateTime @default(now())
  alteradoEm DateTime @updatedAt

  motoristas     Motorista[]
  veiculos       Veiculo[]
  viagens        Viagem[]
  pedagios       Pedagio[]
  abastecimentos Abastecimento[]
  usuarios       UsuarioTransportadora[]
  criadoPor      User?                   @relation("CriouTransportadora", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoPorId    String?

  @@unique([contaId, cnpj])
  @@index([ativa])
  @@index([contaId])
  @@map("transportadoras")
}

/// Vínculo de escopo: quais transportadoras um usuário restrito enxerga.
/// Só tem efeito quando `User.acessoGlobal = false`. Editar exige a permissão
/// `permissoes.gerenciar` (é RBAC, não dado cadastral) — ver UsersService.
model UsuarioTransportadora {
  contaId          String         @default("__SEM_CONTA__")
  conta            Conta          @relation(fields: [contaId], references: [id])
  usuario          User           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId        String
  transportadora   Transportadora @relation(fields: [transportadoraId], references: [id], onDelete: Cascade)
  transportadoraId String
  criadoEm         DateTime       @default(now())

  @@id([usuarioId, transportadoraId])
  @@index([transportadoraId])
  @@index([contaId])
  @@map("usuario_transportadoras")
}

model Empresa {
  contaId          String       @default("__SEM_CONTA__")
  conta            Conta        @relation(fields: [contaId], references: [id])
  id               String       @id @default(uuid())
  nome             String
  cnpj             String?
  contato          String?
  papel            PapelEmpresa @default(AMBOS)
  layoutImport     Json? // mapeamento de colunas do fechamento que ela manda (cached IA inference)
  // Lista de campos que compõem a chave única de match. Default null = ["placa","data","ticket"].
  // Empresa que usa NF como chave seria ["placa","data","nf"] (requer Viagem.nf, V3.1).
  chaveMatch       Json?
  // 0–20 — divergência aceita em km antes de virar DIVERGENCIA. 5 = ±5%.
  toleranciaKmPct  Int          @default(0)
  // 0–10 — idem pra toneladas
  toleranciaTonPct Int          @default(0)
  ativa            Boolean      @default(true)
  criadoEm         DateTime     @default(now())
  alteradoEm       DateTime     @updatedAt

  clientes       Cliente[]
  regrasMinimo   RegraMinimo[]
  fechamentos    Fechamento[]
  layoutsEnvio   LayoutEnvio[]
  layoutsImport  LayoutImportBloco[]
  enviosDiretos  EnvioFechamento[]
  abastecimentos Abastecimento[]
  criadoPor      User?               @relation("CriouEmpresa", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoPorId    String?

  @@unique([contaId, cnpj])
  @@index([ativa])
  @@index([contaId])
  @@map("empresas")
}

/// Bloco de layout de importação por tipo (viagem, pedágio, combustível).
/// Substitui o Empresa.layoutImport: cada empresa pode ter múltiplos
/// blocos cadastrados (1 por tipo). Cada bloco aponta pra uma aba específica
/// da planilha da empresa e mapeia colunas pros campos do nosso sistema.
model LayoutImportBloco {
  contaId          String              @default("__SEM_CONTA__")
  conta            Conta               @relation(fields: [contaId], references: [id])
  id               String              @id @default(uuid())
  empresa          Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId        String
  tipo             TipoBlocoFechamento
  abaPreferida     String?
  linhaCabecalho   Int?
  linhaInicioDados Int?
  // [{letra, cabecalho, campo}] — mesma estrutura do antigo layoutImport
  colunas          Json
  ativo            Boolean             @default(true)
  alteradoEm       DateTime            @updatedAt
  criadoEm         DateTime            @default(now())

  @@unique([empresaId, tipo])
  @@index([empresaId])
  @@index([contaId])
  @@map("layout_import_blocos")
}

model Cliente {
  contaId          String   @default("__SEM_CONTA__")
  conta            Conta    @relation(fields: [contaId], references: [id])
  id               String   @id @default(uuid())
  nome             String
  /// Apelidos/sinônimos pra busca fuzzy do agente WhatsApp. Como o motorista
  /// chama no dia a dia (ex: "cliente do beto", "shopping novo").
  apelidos         String[] @default([])
  empresa          Empresa  @relation(fields: [empresaId], references: [id])
  empresaId        String
  ativa            Boolean  @default(true)
  /// LEGADO (aposentado): mínimo agora é por RegraMinimo (empresa+material+faixa
  /// de km). Colunas mantidas dormentes; nada lê/grava. Não usar.
  toneladasMinimas Decimal? @db.Decimal(10, 3)
  kmMinimos        Decimal? @db.Decimal(10, 2)
  criadoEm         DateTime @default(now())
  alteradoEm       DateTime @updatedAt

  locais      LocalCliente[]
  viagens     Viagem[]
  criadoPor   User?          @relation("CriouCliente", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoPorId String?

  @@index([empresaId])
  @@index([ativa])
  @@index([contaId])
  @@map("clientes")
}

model Material {
  contaId         String   @default("__SEM_CONTA__")
  conta           Conta    @relation(fields: [contaId], references: [id])
  id              String   @id @default(uuid())
  nome            String
  /// Apelidos/sinônimos pra busca fuzzy do agente WhatsApp.
  apelidos        String[] @default([])
  ativo           Boolean  @default(true)
  /// Se false, viagens desse material não exigem número de ticket (ex: concreto,
  /// que não gera ticket de pesagem). Controlado pelo admin, nunca pelo motorista.
  exigeTicket     Boolean  @default(true)
  /// Se true, o motorista pode marcar que precisou voltar pro bota-fora (limpeza):
  /// na última carga ele retorna ao local de carga pra descarregar a sobra. Isso
  /// adiciona a perna descarga→carga ao km faturável. Controlado pelo admin; o
  /// motorista só marca o fato. Ver Viagem.teveBotaFora.
  permiteBotaFora Boolean  @default(false)
  criadoEm        DateTime @default(now())
  alteradoEm      DateTime @updatedAt

  viagens      Viagem[]
  regrasMinimo RegraMinimo[]
  criadoPor    User?         @relation("CriouMaterial", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoPorId  String?

  @@unique([contaId, nome])
  @@index([ativo])
  @@index([contaId])
  @@map("materiais")
}

/// Regra dinâmica de mínimo faturado por empresa + material + faixa de km rodado.
/// Quando a viagem casa (empresa da viagem, material — ou "qualquer" se null —,
/// e km real dentro da faixa), o mínimo da regra vence o mínimo do cliente.
/// kmFaixaDe inclusivo, kmFaixaAte exclusivo (null = sem teto). Pelo menos um
/// dos mínimos (km/toneladas) preenchido.
model RegraMinimo {
  contaId         String    @default("__SEM_CONTA__")
  conta           Conta     @relation(fields: [contaId], references: [id])
  id              String    @id @default(uuid())
  empresa         Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId       String
  material        Material? @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId      String?
  kmFaixaDe       Decimal   @db.Decimal(10, 2)
  kmFaixaAte      Decimal?  @db.Decimal(10, 2)
  kmMinimo        Decimal?  @db.Decimal(10, 2)
  toneladasMinimo Decimal?  @db.Decimal(10, 3)
  ativo           Boolean   @default(true)
  criadoPor       User?     @relation("CriouRegraMinimo", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoPorId     String?
  criadoEm        DateTime  @default(now())
  alteradoEm      DateTime  @updatedAt

  @@index([empresaId, materialId])
  @@index([ativo])
  @@index([contaId])
  @@map("regras_minimo")
}

model Local {
  contaId              String               @default("__SEM_CONTA__")
  conta                Conta                @relation(fields: [contaId], references: [id])
  id                   String               @id @default(uuid())
  nome                 String
  logradouro           String
  numero               String?
  bairro               String?
  cidade               String
  uf                   String               @db.Char(2)
  cep                  String?
  lat                  Float?
  lng                  Float?
  /// Precisão (accuracy em metros) do GPS quando o motorista cadastrou o local
  /// estando nele ("Estou no local", fluxo rápido). null pra locais cadastrados
  /// pelo admin (endereço digitado) ou antigos pré-feature.
  latLngPrecisao       Float?
  /// Fonte do sinal de GPS na captura (PRECISA/BALANCED/CACHE). Complementa a
  /// precisão pra auditar: CACHE = caiu no last-known do sistema (pode estar
  /// defasado). null pra locais do admin / antigos / PWA (não distingue fonte).
  latLngFonte          FonteGps?
  pontoReferencia      String?
  /// Apelidos/sinônimos pra busca fuzzy do agente WhatsApp. Como o motorista
  /// chama no dia a dia (ex: "pedreira nova", "do souza", "balança 2").
  apelidos             String[]             @default([])
  tipo                 TipoLocal
  ativo                Boolean              @default(true)
  /// Confiança no local. Começa RASCUNHO quando motorista cadastra; sobe
  /// sozinho conforme evidências (LocalEvidencia) chegam. RECORRENTE/HUMANO
  /// = limpo, sem destaque no app.
  nivelConfianca       NivelConfiancaLocal  @default(RASCUNHO)
  /// De qual fluxo o local nasceu. null pra registros antigos (pré-rastreio).
  origemCadastro       OrigemCadastroLocal?
  /// Quem cadastrou. null quando criado pelo admin.
  criadoPorMotoristaId String?
  criadoPorMotorista   Motorista?           @relation("LocalCriadoPor", fields: [criadoPorMotoristaId], references: [id])
  ultimaValidacaoEm    DateTime?
  contadorValidacoes   Int                  @default(0)
  criadoEm             DateTime             @default(now())
  alteradoEm           DateTime             @updatedAt

  clientes        LocalCliente[]
  viagensCarga    Viagem[]         @relation("LocalCarga")
  viagensDescarga Viagem[]         @relation("LocalDescarga")
  trechosViagem   TrechoViagem[]
  eventosViagem   EventoViagem[]
  rotasOrigem     RotaCache[]      @relation("RotaOrigem")
  rotasDestino    RotaCache[]      @relation("RotaDestino")
  evidencias      LocalEvidencia[]
  /// Quando o admin cadastra/edita pelo dashboard. Pra motorista, ver criadoPorMotorista.
  criadoPor       User?            @relation("CriouLocal", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoPorId     String?

  @@index([cidade, uf])
  @@index([ativo])
  @@index([nivelConfianca])
  @@index([contaId])
  @@index([contaId, ativo])
  @@map("locais")
}

/// Junction Local↔Cliente (N:N). Um local pode atender vários clientes
/// (pátio compartilhado, pedreira); um cliente tem vários locais.
/// `LocalCliente` vazio (sem entradas pra um Local) = local genérico,
/// aparece pra qualquer cliente em Nova Viagem.
model LocalCliente {
  contaId   String   @default("__SEM_CONTA__")
  conta     Conta    @relation(fields: [contaId], references: [id])
  local     Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId   String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String
  criadoEm  DateTime @default(now())

  @@id([localId, clienteId])
  @@index([clienteId])
  @@index([contaId])
  @@map("local_cliente")
}

/// Histórico de evidências que promoveram um Local. Audit trail pra debug e
/// pra recalcular RECORRENTE contando motoristas distintos.
model LocalEvidencia {
  contaId     String         @default("__SEM_CONTA__")
  conta       Conta          @relation(fields: [contaId], references: [id])
  id          String         @id @default(uuid())
  local       Local          @relation(fields: [localId], references: [id], onDelete: Cascade)
  localId     String
  motorista   Motorista      @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  motoristaId String
  fonte       FonteEvidencia
  viagemId    String?
  /// Dwell em segundos (entre ENTER e EXIT do geofence, ou janela de cluster
  /// do tracking). Null pra GPS_REGISTRO / RECORRENCIA / ADMIN.
  duracaoSeg  Int?
  detectadoEm DateTime       @default(now())

  @@index([localId])
  @@index([motoristaId, localId])
  @@index([contaId])
  @@map("local_evidencia")
}

/// Cache do KM "ideal" da rota carga→descarga calculado pelo OSRM.
/// Re-calcula se calculadoEm > 90 dias (rotas mudam pouco; clientes mais).
model RotaCache {
  id              String   @id @default(uuid())
  localOrigemId   String
  localOrigem     Local    @relation("RotaOrigem", fields: [localOrigemId], references: [id], onDelete: Cascade)
  localDestinoId  String
  localDestino    Local    @relation("RotaDestino", fields: [localDestinoId], references: [id], onDelete: Cascade)
  km              Decimal  @db.Decimal(10, 2)
  duracaoSegundos Int
  /// Polyline encoded (formato Google polyline, precision 5) retornado pelo OSRM
  /// com overview=simplified. NULL pra rotas antigas (pré-feature) — frontend
  /// renderiza reta como fallback. Decodifica com @mapbox/polyline.
  geometria       String?
  /// Versão do algoritmo de roteamento que gerou esta linha. Quando o backend
  /// sobe com uma versão maior (ex.: ligou approaches=curb), entradas com versão
  /// diferente viram stale e recalculam sob demanda. Default 1 = pré-curb.
  versaoRoteador  Int      @default(1)
  calculadoEm     DateTime @default(now())

  @@unique([localOrigemId, localDestinoId])
  @@map("rota_cache")
}

model Viagem {
  contaId                 String             @default("__SEM_CONTA__")
  conta                   Conta              @relation(fields: [contaId], references: [id])
  id                      String             @id @default(uuid())
  clientId                String             @unique // idempotência (gerado no PWA)
  motorista               Motorista          @relation(fields: [motoristaId], references: [id])
  motoristaId             String
  veiculo                 Veiculo            @relation(fields: [veiculoId], references: [id])
  veiculoId               String
  cliente                 Cliente?           @relation(fields: [clienteId], references: [id])
  // Nullable: viagem EM_ANDAMENTO pode não ter cliente/material/data/etc até o
  // finalizar. Obrigatoriedade é validada condicionalmente no service.finalizar.
  clienteId               String?
  material                Material?          @relation(fields: [materialId], references: [id])
  materialId              String?
  data                    DateTime?          @db.Date
  toneladas               Decimal?           @db.Decimal(10, 3)
  /// Null quando o material não exige ticket (ex: concreto). Ver Material.exigeTicket.
  ticket                  String?
  km                      Decimal?           @db.Decimal(10, 2)
  /// Snapshot do km que o OSRM calculou no momento do lançamento. Permite
  /// detectar quando motorista sobrescreveu o sugerido (km != kmCalculado).
  /// Null pra viagens antigas (pré-feature) e quando OSRM não respondeu.
  kmCalculado             Decimal?           @db.Decimal(10, 2)
  /// Semântica de CONTROLE: "não sobrescreva esse km no reprocessamento". true
  /// sempre que o valor foi decidido pelo motorista — digitado na mão OU aceito
  /// da referência histórica (kmFonte=HISTORICO). Escrito pelo backend junto com
  /// kmFonte no create; nenhum caminho escreve os dois de forma independente.
  /// Null pra viagens antigas / app antigo que não envia o flag.
  kmEditadoManual         Boolean?
  /// Semântica de PROCEDÊNCIA (de onde veio o número). Distingue "aceitou o
  /// cálculo", "escolheu rota no mapa", "usou o que a frota já rodou nesse
  /// trajeto" e "digitou na mão" — coisas que kmEditadoManual sozinho não separa
  /// e que a timeline/painel precisam contar direito (usar a referência do
  /// trajeto NÃO é "ajustou o km na mão"). Null = app antigo.
  kmFonte                 KmFonte?
  /// Reprocessamento de km: quando a viagem foi criada sem sinal (km estimado
  /// por haversine), o backend recalcula pelo trajeto real (OSRM) ao sincronizar.
  /// kmRecalculadoEm = quando recalculou (também trava re-processo/re-aviso);
  /// kmAntesRecalculo = km que estava antes, pra mostrar "de X → Y" pro motorista.
  kmRecalculadoEm         DateTime?
  kmAntesRecalculo        Decimal?           @db.Decimal(10, 2)
  /// Detecção de km atípico: o backend compara o km desta viagem com o que a
  /// frota já rodou nesse par carga→descarga (mediana) ou, sem amostra, com a
  /// rota OSRM. Carimbo é sempre do BACKEND (o app pode estar offline/burlado).
  /// kmForaDoPadrao null = não avaliado (viagem com trechos, sem local, etc).
  /// Os kmReferencia* são SNAPSHOT do que a referência valia no carimbo — a
  /// mediana anda com o tempo e o badge precisa continuar explicável depois.
  kmForaDoPadrao          Boolean?
  kmReferencia            Decimal?           @db.Decimal(10, 2)
  kmReferenciaFonte       FonteReferenciaKm?
  kmReferenciaAmostra     Int?
  kmDesvioPct             Decimal?           @db.Decimal(6, 2)
  kmAvaliadoEm            DateTime?
  /// "Aceitar km" no painel: admin confirma que o km atípico está correto e
  /// readmite a viagem na mediana do par (KmAtipicoService.filtroAmostra).
  /// Dedicado — NÃO é revisadoEm: aceitar km é uma decisão diferente de
  /// pré-validar a viagem, e as duas não podem se confundir (uma não implica
  /// a outra, nem no card do painel nem no FechamentoProcessor).
  kmAceitoEm              DateTime?
  /// Texto que o motorista escreveu ao insistir num km fora do padrão. Fato
  /// histórico dele: o re-carimbo automático NUNCA mexe aqui. Null é estado
  /// válido e esperado mesmo com kmForaDoPadrao=true (lançou offline, app
  /// antigo, flag off) — o lançamento nunca é bloqueado por causa disso.
  justificativaKm         String?
  /// Polyline (formato Google, precision 5) da rota que o motorista ESCOLHEU
  /// entre as alternativas OSRM no seletor de mapa. Null = não usou o seletor
  /// (viagem antiga, rota única ou offline) → painel cai no rotaCache
  /// (recomendada). Não-null também sinaliza "escolheu rota" no painel.
  rotaGeometria           String?
  /// Escolha "voltei no retorno vs segui direto" (pista dupla): true = COM retorno
  /// (curb), false = SEM retorno (direto), null = não perguntado (sem retorno real,
  /// viagem antiga ou app antigo). O "Recalcular trajeto" do painel RESPEITA esse
  /// campo em vez de sempre aplicar a variante com retorno.
  retornoConfirmado       Boolean?
  /// Trechos ADICIONAIS do trajeto além da carga→descarga base: hoje o retorno do
  /// bota-fora (limpeza), amanhã entregas múltiplas. O km faturável (`km`) já inclui
  /// a soma dos trechos. Ver model TrechoViagem.
  trechos                 TrechoViagem[]
  observacao              String?
  status                  StatusViagem       @default(ENVIADA)
  /// true = viagem aberta pelo fluxo guiado "Iniciar viagem" (lifecycle). Setado
  /// no iniciar() e persiste após finalizar (ENVIADA). O "Nova viagem" direto
  /// fica false. Marcador confiável de origem (≠ ter EventoViagem, que não é
  /// garantido). Alimenta o selo "Guiada" + filtro de origem no painel.
  iniciadaGuiada          Boolean            @default(false)
  // Nullable p/ lifecycle: localCarga é preenchido no evento de carga (ou no
  // iniciar se GPS detectou), localDescarga no evento de descarga/finalizar.
  localCarga              Local?             @relation("LocalCarga", fields: [localCargaId], references: [id])
  localCargaId            String?
  localDescarga           Local?             @relation("LocalDescarga", fields: [localDescargaId], references: [id])
  localDescargaId         String?
  valorPedagioTotal       Decimal?           @db.Decimal(10, 2)
  // Coordenadas GPS capturadas pelo motorista no momento do lançamento
  // (silencioso — null se permissão negada ou GPS indisponível)
  lat                     Float?
  lng                     Float?
  // Captura do GPS quando o motorista tocou "Estou no local de descarga":
  // posição dele, precisão do sinal (accuracy em metros) e distância até o
  // local que ele acabou selecionando. Auditoria de confiabilidade da
  // marcação. Null quando não houve captura fresca (edição reaproveitando
  // local já selecionado, ou viagem antiga pré-feature).
  descargaLat             Float?
  descargaLng             Float?
  descargaPrecisao        Float? // accuracy em metros do GPS no clique
  // Fonte do sinal na captura da descarga (PRECISA/BALANCED/CACHE). Complementa
  // a precisão: CACHE = last-known do sistema (posição pode estar defasada).
  // null pra viagem antiga pré-feature, sem captura fresca, ou PWA.
  descargaFonte           FonteGps?
  descargaDistanciaMetros Int? // distância do clique até o local selecionado
  // Raio (m) em que o local foi encontrado na busca (inicial ou ampliado, da
  // config do painel). Auditoria: quão "solta" foi a marcação. Null pra viagem
  // antiga, local novo cadastrado na hora (sem match), ou PWA.
  descargaRaioUsadoM      Int?
  // true = a busca de locais no clique caiu no catálogo em cache (sem internet),
  // então pode ter faltado algum local criado por outro motorista recentemente.
  // null = não capturado (viagem antiga pré-feature ou sem captura fresca).
  descargaBuscaOffline    Boolean?
  // Espelho da captura da descarga, mas pro LOCAL DE CARGA no "Iniciar viagem":
  // GPS real do motorista ao escolher a carga + distância/raio até o local. Como
  // o raio da carga virou ordenação (não trava), isso audita quão longe ele
  // iniciou. Null pra "Nova viagem" direta, viagem antiga ou PWA.
  cargaLat                Float?
  cargaLng                Float?
  cargaPrecisao           Float?
  cargaFonte              FonteGps?
  cargaDistanciaMetros    Int?
  cargaRaioUsadoM         Int?
  cargaBuscaOffline       Boolean?
  // Tracking GPS do trajeto (opcional — só preenchido se motorista usou "Iniciar viagem")
  iniciadoEm              DateTime? // quando tocou Iniciar
  kmReal                  Decimal?           @db.Decimal(10, 2) // somatório das distâncias entre pontos consecutivos
  /// Rastreamento granular do OCR de ticket via IA. Cada campo preenchido
  /// pela IA (e mantido pelo motorista até o submit) entra no array. Ex:
  /// ["ticket","toneladas","clienteId"]. Quando motorista edita um campo
  /// depois de aplicar IA, ele sai do array (não é mais "valor da IA").
  ocrCampos               String[]           @default([])
  /// Confidence geral da extração OCR (0..1). Null se IA não rodou.
  ocrConfidence           Float?
  /// Pré-validação manual pelo admin no dashboard. Quando revisadoEm está
  /// preenchido, o FechamentoProcessor NÃO sobrescreve o status no match
  /// (preserva a decisão manual). Exclusivo do fluxo de pré-validação — "Aceitar
  /// km" (km atípico) usa kmAceitoEm, não este campo.
  revisadoEm              DateTime?
  revisadoPor             User?              @relation("RevisouViagem", fields: [revisadoPorId], references: [id], onDelete: SetNull)
  revisadoPorId           String?
  /// Texto obrigatório quando status foi marcado DIVERGENTE via pré-validação.
  motivoStatus            String?
  /// Tipifica a divergência pra UI dedicada no app motorista (ex: card pedindo
  /// só o valor do pedágio em vez do fluxo genérico de edição). Limpo quando
  /// motorista resolve. Default null = divergência genérica (motorista corrige
  /// editando a viagem normalmente).
  tipoDivergencia         TipoDivergencia?
  criadoOfflineEm         DateTime?
  sincronizadoEm          DateTime           @default(now())
  alteradoEm              DateTime           @updatedAt
  /// Versão do app usada na CRIAÇÃO (headers x-app-version / x-app-update-id do
  /// app nativo). Null pra viagens antigas ou PWA. Só pra auditoria/suporte.
  appVersaoCriacao        String?
  appUpdateIdCriacao      String?
  /// Frota dona da viagem, CARIMBADA na criação (motorista.transportadoraId ??
  /// veiculo.transportadoraId). Desnormalizado de propósito: reclassificar um
  /// motorista não pode mover o histórico dele de uma frota pra outra. Também
  /// evita JOIN em toda listagem/count e deixa o filtro trivial no SQL cru.
  transportadora          Transportadora?    @relation(fields: [transportadoraId], references: [id], onDelete: SetNull)
  transportadoraId        String?

  fotos             TicketFoto[]
  pedagios          Pedagio[]
  pontos            ViagemPonto[]
  matchesFechamento FechamentoLinha[]
  eventos           EventoMotorista[]
  eventosViagem     EventoViagem[]
  mensagens         ViagemMensagem[]
  compartilhamentos ViagemCompartilhamento[]

  @@index([transportadoraId, data])
  @@index([motoristaId, data])
  @@index([veiculoId, data])
  @@index([clienteId, data])
  @@index([veiculoId, data, ticket])
  @@index([status])
  // Serve tanto a busca por par (referência de km atípico) quanto o filtro só
  // por localCargaId, que é prefixo dele — por isso não há @@index([localCargaId]).
  @@index([localCargaId, localDescargaId, data])
  @@index([localDescargaId])
  // Relatório de produção por período. Os índices acima todos LIDERAM por outra
  // coluna, então um recorte só por data (relatório sem filtro de dimensão) não
  // usa nenhum deles e cai em seq scan.
  @@index([data])
  // Única dimensão do relatório que não tinha índice composto com data.
  @@index([materialId, data])
  // Partial unique index "1 viagem EM_ANDAMENTO por motorista" é criado à mão
  // no migration.sql (Prisma não expressa índice parcial): ver migration
  // add_viagem_lifecycle (uq_viagem_em_andamento_por_motorista).
  @@index([contaId])
  @@index([contaId, data])
  @@index([contaId, status])
  @@map("viagens")
}

/// Procedência do km faturável da viagem. Ver Viagem.kmFonte.
enum KmFonte {
  /// Aceitou o valor que o app auto-preencheu pelo trajeto calculado (OSRM).
  ROTA_OSRM
  /// Escolheu uma das rotas alternativas no seletor de mapa.
  ROTA_ESCOLHIDA
  /// Tocou "Usar X km" na referência do que a frota já rodou nesse trajeto.
  HISTORICO
  /// Digitou o número na mão.
  MANUAL
}

/// Contra o que o km da viagem foi comparado na detecção de atípico.
enum FonteReferenciaKm {
  /// Mediana das viagens da frota nesse par (amostra >= amostraMinima).
  HISTORICO
  /// Sem amostra suficiente → caiu na rota calculada. Régua própria, mais
  /// frouxa: o OSRM é sistematicamente baixo em trajeto interno/pedreira.
  ROTA_OSRM
}

/// Tipo de um trecho adicional da viagem (além da carga→descarga base).
enum TipoTrecho {
  /// Volta pro local de CARGA pra descarregar a sobra na última carga ("limpeza"/
  /// bota-fora). localId = local de carga. Só quando Material.permiteBotaFora.
  RETORNO_BOTA_FORA
  /// Entrega adicional (múltiplas entregas). Uso futuro.
  ENTREGA
}

/// Trecho ADICIONAL do trajeto, além da carga→descarga base da viagem. Modela o
/// retorno do bota-fora hoje e abre caminho pra múltiplas entregas no futuro
/// (cada trecho com seu peso/ticket próprios, quando fizer sentido). O km faturável
/// da Viagem (`km`) já inclui a soma dos `km` dos trechos — aqui fica o detalhamento.
model TrechoViagem {
  contaId   String     @default("__SEM_CONTA__")
  conta     Conta      @relation(fields: [contaId], references: [id])
  id        String     @id @default(uuid())
  viagem    Viagem     @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  viagemId  String
  /// Sequência do trecho (1, 2, 3...) depois da descarga base.
  ordem     Int
  tipo      TipoTrecho
  /// Local de destino deste trecho (no bota-fora = o local de carga).
  local     Local      @relation(fields: [localId], references: [id])
  localId   String
  /// Distância (km) do ponto anterior até o local deste trecho.
  km        Decimal    @db.Decimal(10, 2)
  /// Futuro (múltiplas entregas): peso/ticket próprios por entrega. Null no bota-fora.
  toneladas Decimal?   @db.Decimal(10, 3)
  ticket    String?
  criadoEm  DateTime   @default(now())

  @@index([viagemId, ordem])
  @@index([contaId])
  @@map("trechos_viagem")
}

/// Catálogo dinâmico de tipos de evento da viagem (lifecycle guiado). Admin
/// cria/edita pelo dashboard; o app renderiza os botões a partir daqui (sem
/// fluxo hardcoded). A "espinha" da máquina de estados = tipos obrigatorio=true
/// ordenados por `ordem`; o próximo obrigatório não registrado vira o botão
/// primário. Seed inicial: carga + descarga.
model TipoEventoViagem {
  contaId        String   @default("__SEM_CONTA__")
  conta          Conta    @relation(fields: [contaId], references: [id])
  id             String   @id @default(uuid())
  /// Chave estável usada no código/snapshot (ex: "carga", "descarga"). Imutável.
  slug           String
  /// Rótulo exibido ao motorista (editável pelo admin).
  nome           String
  ativo          Boolean  @default(true)
  /// Ordena a espinha e os botões no app.
  ordem          Int      @default(0)
  // --- máquina de estados ---
  /// true = marco da espinha; bloqueia "Finalizar" enquanto não registrado.
  obrigatorio    Boolean  @default(false)
  /// true = pode registrar várias vezes na mesma viagem (parada, abastecimento).
  repetivel      Boolean  @default(false)
  // --- marcos que espelham campos da Viagem ---
  /// Preenche Viagem.localCargaId + iniciadoEm/lat/lng ao registrar.
  ehCarga        Boolean  @default(false)
  /// Preenche Viagem.localDescargaId + descargaLat/Lng ao registrar.
  ehDescarga     Boolean  @default(false)
  // --- o que o evento pede ao motorista ---
  pedeGps        Boolean  @default(true)
  pedeFoto       Boolean  @default(false)
  pedeToneladas  Boolean  @default(false)
  pedeValor      Boolean  @default(false)
  pedeTicket     Boolean  @default(false)
  pedeObservacao Boolean  @default(true)
  criadoEm       DateTime @default(now())
  alteradoEm     DateTime @updatedAt
  criadoPor      User?    @relation("CriouTipoEventoViagem", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoPorId    String?

  eventos EventoViagem[]

  @@unique([contaId, slug])
  @@index([ativo, ordem])
  @@index([contaId])
  @@map("tipos_evento_viagem")
}

/// Evento de negócio registrado durante uma viagem em andamento (carga,
/// descarga, parada...). Idempotente por `id` (uuid client-side). Diferente de
/// EventoMotorista, que é telemetria (string livre, retenção curta).
model EventoViagem {
  contaId         String           @default("__SEM_CONTA__")
  conta           Conta            @relation(fields: [contaId], references: [id])
  id              String           @id
  viagem          Viagem           @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  viagemId        String
  tipoEvento      TipoEventoViagem @relation(fields: [tipoEventoId], references: [id])
  tipoEventoId    String
  /// Snapshot do slug do tipo — resiliente a rename/soft-delete do catálogo.
  tipoSlug        String
  lat             Float?
  lng             Float?
  precisao        Float?
  local           Local?           @relation(fields: [localId], references: [id], onDelete: SetNull)
  localId         String?
  fotoKey         String?
  toneladas       Decimal?         @db.Decimal(10, 3)
  valor           Decimal?         @db.Decimal(10, 2)
  ticket          String?
  observacao      String?
  ocorridoEm      DateTime
  criadoOfflineEm DateTime?
  recebidoEm      DateTime         @default(now())

  @@index([viagemId, ocorridoEm])
  @@index([tipoEventoId])
  @@index([contaId])
  @@map("eventos_viagem")
}

/// Autor de uma mensagem do chat da viagem. Motorista NÃO é User (entidades
/// separadas), por isso o autor precisa dos dois lados possíveis.
enum AutorMensagem {
  ADMIN
  MOTORISTA
}

/// Chat por viagem (admin <-> motorista). Substitui a "sopa" de motivoStatus
/// (sobrescrito) + observacao (append): cada rodada de divergência, e qualquer
/// mensagem livre, vira uma linha com autor + data/hora. motivoStatus/
/// tipoDivergencia continuam governando os cards de resolução; o chat é o log.
model ViagemMensagem {
  contaId     String        @default("__SEM_CONTA__")
  conta       Conta         @relation(fields: [contaId], references: [id])
  id          String        @id @default(uuid())
  viagem      Viagem        @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  viagemId    String
  autor       AutorMensagem
  /// Um dos dois preenchido conforme o autor (motorista não é User).
  usuario     User?         @relation("MensagensViagem", fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioId   String?
  motorista   Motorista?    @relation("MensagensViagem", fields: [motoristaId], references: [id], onDelete: SetNull)
  motoristaId String?
  /// Snapshot do nome do autor — sobrevive à exclusão do User/Motorista.
  autorNome   String
  texto       String
  /// null = mensagem livre. Senão ação estruturada, pra a UI dar selo/ícone:
  /// MARCOU_DIVERGENTE | CORRIGIU_KM | INFORMOU_PEDAGIO | ENVIOU_FOTO.
  acao        String?
  criadoEm    DateTime      @default(now())

  @@index([viagemId, criadoEm])
  @@index([contaId])
  @@map("viagem_mensagens")
}

model TicketFoto {
  contaId     String   @default("__SEM_CONTA__")
  conta       Conta    @relation(fields: [contaId], references: [id])
  id          String   @id @default(uuid())
  viagem      Viagem   @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  viagemId    String
  storageKey  String // chave no MinIO
  /// Rotação aplicada via CSS na exibição admin. 0/90/180/270. Persistente.
  rotacao     Int      @default(0)
  capturadaEm DateTime @default(now())

  @@index([viagemId])
  @@index([contaId])
  @@map("ticket_fotos")
}

/// Link público (sem login) do comprovante de uma viagem, gerado no painel e
/// mandado pro cliente/embarcador no WhatsApp. É uma capability URL: quem tem o
/// token vê, então o controle é ENTROPIA + VALIDADE + REVOGAÇÃO, não sessão.
///
/// O que o link mostra é o whitelist de `compartilhamento/viagem-publica.ts` —
/// NUNCA o payload do detalhe admin (que tem CPF, GPS bruto, telemetria, etc).
model ViagemCompartilhamento {
  contaId  String @default("__SEM_CONTA__")
  conta    Conta  @relation(fields: [contaId], references: [id])
  id       String @id @default(uuid())
  viagem   Viagem @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  viagemId String
  /// 32 chars base64url (192 bits de randomBytes). Guardado em CLARO porque o
  /// painel precisa listar/copiar/reenviar o link depois; hash mataria isso.
  /// Em compensação: nunca vai pra log nem pro AuditLog (que é legível por
  /// qualquer um com viagens.ver — viraria uma lista de links vivos).
  token    String @unique

  criadoPor   User?   @relation("CompartilhouViagem", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoPorId String?

  expiraEm      DateTime
  /// Soft-revoke: a linha NUNCA é apagada, senão o histórico de quem expôs o
  /// quê some junto com a evidência.
  revogadoEm    DateTime?
  revogadoPor   User?     @relation("RevogouCompartilhamento", fields: [revogadoPorId], references: [id], onDelete: SetNull)
  revogadoPorId String?

  /// Telemetria mínima de acesso. De propósito SEM tabela por visualização:
  /// cresceria sem teto e viraria rastreamento do cliente, não auditoria.
  visualizacoes    Int       @default(0)
  primeiroAcessoEm DateTime?
  ultimoAcessoEm   DateTime?
  ultimoAcessoIp   String?

  /// Envio pelo WhatsApp (número normalizado com DDI). Null = link só copiado.
  destinatarioTelefone String?
  enviadoEm            DateTime?

  criadoEm DateTime @default(now())

  @@index([viagemId, criadoEm])
  @@index([expiraEm])
  @@index([contaId])
  @@map("viagem_compartilhamentos")
}

/// Story do motorista (estilo Instagram): foto do trecho que todos os
/// motoristas veem. Efêmero — expira em 24h (job de limpeza remove foto do
/// MinIO + registro). O feed filtra por expiraEm > now, então nunca aparece
/// expirado mesmo que a limpeza atrase. clientId dá idempotência ao outbox.
/// A cópia de segurança de um lançamento que o app não conseguiu enviar.
///
/// Regra que isso existe pra garantir: lançamento que o motorista fez NÃO some.
/// Quando o outbox recusa um item de vez (4xx: placa excluída, cliente apagado,
/// ticket repetido), o conteúdo dele mora num lugar só — o celular. Basta o
/// motorista descartar pra limpar a tela, trocar de aparelho ou reinstalar, e a
/// viagem evapora sem ninguém no escritório saber que existiu.
///
/// Nenhuma coluna daqui aponta pra cadastro (o payload é Json solto), e é de
/// propósito: esta gravação não pode falhar pelo mesmo motivo que derrubou o
/// lançamento original. Se ela dependesse do veiculoId, morreria junto.
///
/// Não substitui o outbox — o item continua no celular e continua podendo ser
/// corrigido lá. Isto é a segunda cópia, pra quando o celular não colaborar.
model LancamentoResgatado {
  contaId         String            @default("__SEM_CONTA__")
  conta           Conta             @relation(fields: [contaId], references: [id])
  id              String            @id @default(uuid())
  /// O mesmo clientId do outbox: reenvio atualiza a linha em vez de duplicar, e
  /// é por ele que o backend reconhece quando o lançamento finalmente entrou.
  clientId        String
  tipo            String
  motorista       Motorista         @relation(fields: [motoristaId], references: [id])
  motoristaId     String
  /// Snapshot do nome: a tela precisa continuar legível mesmo se o cadastro do
  /// motorista mudar de nome depois.
  motoristaNome   String
  payload         Json
  erroMensagem    String?
  erroStatus      Int?
  appVersao       String?
  criadoOfflineEm DateTime?
  recebidoEm      DateTime          @default(now())
  atualizadoEm    DateTime          @updatedAt
  resolucao       ResolucaoResgate?
  resolvidoEm     DateTime?
  resolvidoPor    User?             @relation(fields: [resolvidoPorId], references: [id])
  resolvidoPorId  String?
  observacao      String?

  @@unique([clientId, tipo])
  @@index([contaId, resolvidoEm])
  @@index([motoristaId])
  @@map("lancamentos_resgatados")
}

/// SUBIU_SOZINHO é carimbo do BACKEND, não escolha de quem está na tela: vale
/// quando o lançamento daquele clientId acabou entrando (o motorista corrigiu no
/// app, ou o cadastro voltou). Sem ele a tela encheria de caso já resolvido — e
/// tela cheia de ruído é tela que ninguém abre.
enum ResolucaoResgate {
  SUBIU_SOZINHO
  LANCADO_NO_PAINEL
  DESCARTADO
}

model Story {
  contaId       String              @default("__SEM_CONTA__")
  conta         Conta               @relation(fields: [contaId], references: [id])
  id            String              @id @default(uuid())
  clientId      String              @unique // gerado no app (outbox)
  motorista     Motorista           @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  motoristaId   String
  storageKey    String // chave no MinIO
  legenda       String?
  lat           Float?
  lng           Float?
  criadoEm      DateTime            @default(now())
  expiraEm      DateTime // = criadoEm + 24h
  visualizacoes StoryVisualizacao[]
  reacoes       StoryReacao[]

  @@index([expiraEm])
  @@index([motoristaId, criadoEm])
  @@index([contaId])
  @@map("stories")
}

/// Registro de que um motorista viu um story (tira o anel de "não visto" e
/// alimenta o "visto por N" do autor). Único por (story, motorista).
model StoryVisualizacao {
  contaId     String    @default("__SEM_CONTA__")
  conta       Conta     @relation(fields: [contaId], references: [id])
  id          String    @id @default(uuid())
  story       Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId     String
  motorista   Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  motoristaId String
  vistoEm     DateTime  @default(now())

  @@unique([storyId, motoristaId])
  @@index([storyId])
  @@index([contaId])
  @@map("story_visualizacoes")
}

/// Reação emoji de um motorista a um story. Uma por (story, motorista) — upsert
/// troca o emoji anterior.
model StoryReacao {
  contaId     String    @default("__SEM_CONTA__")
  conta       Conta     @relation(fields: [contaId], references: [id])
  id          String    @id @default(uuid())
  story       Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId     String
  motorista   Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  motoristaId String
  emoji       String
  criadoEm    DateTime  @default(now())

  @@unique([storyId, motoristaId])
  @@index([storyId])
  @@index([contaId])
  @@map("story_reacoes")
}

/// Ponto GPS capturado durante o tracking de uma viagem.
/// Polyline reconstruída ordenando por capturadoEm. Pontos com precisao>100m
/// ou velocidade>200km/h são filtrados no app antes de enviar; depois passam
/// por Douglas-Peucker (tolerancia 3m) pra remover redundancia.
model ViagemPonto {
  contaId     String   @default("__SEM_CONTA__")
  conta       Conta    @relation(fields: [contaId], references: [id])
  id          String   @id @default(uuid())
  viagem      Viagem   @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  viagemId    String
  lat         Float
  lng         Float
  capturadoEm DateTime
  velocidade  Float? // m/s (vinda do GPS)
  precisao    Float? // accuracy em metros

  @@index([viagemId, capturadoEm])
  @@index([capturadoEm])
  @@index([contaId])
  @@map("viagem_pontos")
}

model Pedagio {
  contaId          String          @default("__SEM_CONTA__")
  conta            Conta           @relation(fields: [contaId], references: [id])
  id               String          @id @default(uuid())
  clientId         String          @unique
  veiculo          Veiculo         @relation(fields: [veiculoId], references: [id])
  veiculoId        String
  motorista        Motorista       @relation(fields: [motoristaId], references: [id])
  motoristaId      String
  data             DateTime        @db.Date
  pracaPedagio     String
  valor            Decimal         @db.Decimal(10, 2)
  viagem           Viagem?         @relation(fields: [viagemId], references: [id])
  viagemId         String?
  criadoOfflineEm  DateTime?
  sincronizadoEm   DateTime        @default(now())
  /// Carimbada na criação — ver Viagem.transportadoraId.
  transportadora   Transportadora? @relation(fields: [transportadoraId], references: [id], onDelete: SetNull)
  transportadoraId String?

  fechamentoLinhas FechamentoLinha[]

  @@index([veiculoId, data])
  @@index([viagemId])
  @@index([transportadoraId, data])
  // Reconciliação de pedágio por motorista no relatório de produção.
  @@index([motoristaId, data])
  @@index([contaId])
  @@index([contaId, data])
  @@map("pedagios")
}

model Fechamento {
  contaId             String           @default("__SEM_CONTA__")
  conta               Conta            @relation(fields: [contaId], references: [id])
  id                  String           @id @default(uuid())
  empresa             Empresa          @relation(fields: [empresaId], references: [id])
  empresaId           String
  periodoInicio       DateTime         @db.Date
  periodoFim          DateTime         @db.Date
  fonte               FonteFechamento
  arquivoOriginalKey  String?
  arquivoOriginalNome String?
  arquivoMimetype     String?
  versao              Int              @default(1)
  substituidoPor      Fechamento?      @relation("FechamentoVersao", fields: [substituidoPorId], references: [id])
  substituidoPorId    String?
  substitui           Fechamento[]     @relation("FechamentoVersao")
  layoutSalvo         Json? // snapshot do layout usado na inferência (debug/auditoria)
  status              StatusFechamento @default(RECEBIDO)
  resumoIa            Json? // estatísticas da execução: total, match_auto, match_ia, divergencia, falta, extra
  criadoEm            DateTime         @default(now())
  alteradoEm          DateTime         @updatedAt

  linhas      FechamentoLinha[]
  envios      EnvioFechamento[]
  criadoPor   User?             @relation("CriouFechamento", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoPorId String?

  @@index([empresaId, periodoInicio])
  @@index([status])
  @@index([contaId])
  @@map("fechamentos")
}

model FechamentoLinha {
  contaId              String                @default("__SEM_CONTA__")
  conta                Conta                 @relation(fields: [contaId], references: [id])
  id                   String                @id @default(uuid())
  fechamento           Fechamento            @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)
  fechamentoId         String
  ordem                Int // posição original na planilha
  // Tipo do bloco que originou esta linha (vem do LayoutImportBloco usado).
  // Default VIAGEM pra compatibilidade com linhas antigas.
  tipo                 TipoBlocoFechamento   @default(VIAGEM)
  rawData              Json // dados brutos extraídos da linha (todas as colunas)
  placa                String?
  data                 DateTime?             @db.Date
  ticket               String?
  km                   Decimal?              @db.Decimal(10, 2)
  toneladas            Decimal?              @db.Decimal(10, 3)
  valor                Decimal?              @db.Decimal(10, 2)
  clienteTexto         String? // texto do cliente na planilha (pode não bater com nosso Cliente)
  materialTexto        String? // texto do material na planilha
  // Apenas UM dos 3 matchIds é preenchido por linha, conforme `tipo`:
  // VIAGEM → viagemMatchId, PEDAGIO → pedagioMatchId, COMBUSTIVEL → abastecimentoMatchId
  viagemMatch          Viagem?               @relation(fields: [viagemMatchId], references: [id])
  viagemMatchId        String?
  pedagioMatch         Pedagio?              @relation(fields: [pedagioMatchId], references: [id])
  pedagioMatchId       String?
  abastecimentoMatch   Abastecimento?        @relation(fields: [abastecimentoMatchId], references: [id])
  abastecimentoMatchId String?
  status               StatusLinhaFechamento
  divergencias         Json? // { campo: { motorista, empresa } }
  sugestaoIa           Json? // { viagemId, confidence, motivo }
  resolvidoPor         User?                 @relation(fields: [resolvidoPorId], references: [id])
  resolvidoPorId       String?
  resolvidoEm          DateTime?
  motivoResolucao      String?

  @@index([fechamentoId, status])
  @@index([fechamentoId, tipo])
  @@index([viagemMatchId])
  @@index([pedagioMatchId])
  @@index([abastecimentoMatchId])
  @@index([contaId])
  @@map("fechamento_linhas")
}

model LayoutEnvio {
  contaId     String   @default("__SEM_CONTA__")
  conta       Conta    @relation(fields: [contaId], references: [id])
  id          String   @id @default(uuid())
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId   String
  nome        String // ex: "Planilha mensal viagens", "Pedágios"
  colunas     Json // [{ campo, header, ordem, formato? }]
  config      Json? // { incluiCabecalhoEmpresa, formatoData, separadorDecimal }
  padrao      Boolean  @default(false)
  criadoPor   User?    @relation(fields: [criadoPorId], references: [id])
  criadoPorId String?
  criadoEm    DateTime @default(now())
  alteradoEm  DateTime @updatedAt

  envios EnvioFechamento[]

  @@index([empresaId])
  @@index([contaId])
  @@map("layouts_envio")
}

model EnvioFechamento {
  contaId          String       @default("__SEM_CONTA__")
  conta            Conta        @relation(fields: [contaId], references: [id])
  id               String       @id @default(uuid())
  // Quando o envio for fruto de uma planilha que a empresa nos mandou e
  // depois exportamos de volta, fica vinculado ao Fechamento. Quando for
  // um envio standalone (empresa que so RECEBE planilha), fechamentoId
  // fica null e usamos empresa/periodoInicio/periodoFim direto.
  fechamento       Fechamento?  @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)
  fechamentoId     String?
  empresa          Empresa?     @relation(fields: [empresaId], references: [id])
  empresaId        String?
  periodoInicio    DateTime?    @db.Date
  periodoFim       DateTime?    @db.Date
  totalLinhas      Int? // qtde de viagens incluídas no XLSX
  layout           LayoutEnvio? @relation(fields: [layoutId], references: [id])
  layoutId         String?
  arquivoGeradoKey String // XLSX no MinIO
  arquivoNome      String // nome legível pra download
  geradoPor        User?        @relation(fields: [geradoPorId], references: [id])
  geradoPorId      String?
  geradoEm         DateTime     @default(now())
  status           StatusEnvio  @default(GERADO)
  marcadoEnviadoEm DateTime?
  canalEnvio       String? // WhatsApp, email, etc
  observacao       String?

  @@index([fechamentoId])
  @@index([empresaId, periodoInicio])
  @@index([contaId])
  @@map("envios_fechamento")
}

model AuditLog {
  contaId     String        @default("__SEM_CONTA__")
  conta       Conta         @relation(fields: [contaId], references: [id])
  id          String        @id @default(uuid())
  usuario     User?         @relation(fields: [usuarioId], references: [id])
  usuarioId   String?
  entidade    String // "Viagem", "Pedagio", "FechamentoLinha", etc
  entidadeId  String // id do registro afetado
  acao        AcaoAuditoria
  campo       String? // campo alterado (null se for ação ampla)
  valorAntes  Json?
  valorDepois Json?
  motivo      String? // texto livre quando humano resolve divergência ou justifica
  metadata    Json? // dados extras (confidence da IA, sugestão usada, etc)
  criadoEm    DateTime      @default(now())

  @@index([entidade, entidadeId])
  @@index([usuarioId, criadoEm])
  @@index([contaId])
  @@map("audit_logs")
}

model GeocodingCache {
  id        String   @id @default(uuid())
  query     String   @unique // texto buscado normalizado (lowercase trim)
  resposta  Json // array de SugestaoEndereco[]
  hits      Int      @default(1)
  criadoEm  DateTime @default(now())
  ultimoHit DateTime @default(now())

  @@index([query])
  @@map("geocoding_cache")
}

/// Configuração global do tracking GPS aplicado a todos os motoristas.
/// Singleton: só existe uma linha (id="default"). Operadora ajusta pelo dashboard.
model ConfiguracaoTracking {
  contaId               String   @default("__SEM_CONTA__")
  conta                 Conta    @relation(fields: [contaId], references: [id])
  id                    String   @id @default(uuid())
  // Captura GPS
  distanciaMinMetros    Int      @default(50) // captura a cada N metros andados
  intervaloMaxSegundos  Int      @default(30) // ou a cada N segundos (o que ocorrer 1º)
  precisaoAlta          Boolean  @default(false) // true = High accuracy (mais bateria)
  // Filtros — descarta pontos ruins antes de salvar
  accuracyMaxMetros     Int      @default(100) // descarta se accuracy > N
  velocidadeMaxKmh      Int      @default(200) // descarta se velocidade > N km/h
  // Auto-finalização e detector híbrido
  autoFinalizarHoras    Int      @default(6) // notifica se viagem ativa > N horas sem ponto
  detectorAtivado       Boolean  @default(true) // detecta movimento sem tracking ativo
  detectorVelocidadeKmh Int      @default(30) // velocidade pra disparar detector
  detectorLeituras      Int      @default(3) // leituras consecutivas pra notificar
  // Audit
  alteradoEm            DateTime @updatedAt
  alteradoPor           User?    @relation(fields: [alteradoPorId], references: [id])
  alteradoPorId         String?

  @@unique([contaId])
  @@map("configuracao_tracking")
}

/// Singleton (id="default"): parâmetros do match por IA do fechamento.
/// Lazy-create no primeiro acesso. Atualizada via /admin/ia-config.
model ConfiguracaoIa {
  contaId          String   @default("__SEM_CONTA__")
  conta            Conta    @relation(fields: [contaId], references: [id])
  id               String   @id @default(uuid())
  // 0.50–0.99 — quanto maior, mais conservador (menos auto-resolução)
  confidenceMinimo Float    @default(0.85)
  // 1–14 — janela de datas pra filtrar viagens candidatas (mesma placa, ±N dias)
  janelaDias       Int      @default(3)
  // Modelo Claude usado nas chamadas (match + inferência de layout).
  // Trade-off custo vs qualidade. Valores: claude-haiku-4-5-20251001 (default),
  // claude-sonnet-4-6, claude-opus-4-7.
  modelo           String   @default("claude-haiku-4-5-20251001")
  alteradoEm       DateTime @updatedAt
  alteradoPor      User?    @relation(fields: [alteradoPorId], references: [id])
  alteradoPorId    String?

  @@unique([contaId])
  @@map("configuracao_ia")
}

/// Singleton (id="default"): config do agente IA do WhatsApp (motorista/admin).
/// Separada da ConfiguracaoIa porque o trade-off é diferente: conciliação roda
/// em background (tolera latência), agente chat é em tempo real (latência conta).
/// API keys ficam em env var — aqui só seleciona provider e modelo.
model ConfiguracaoAgente {
  contaId         String   @default("__SEM_CONTA__")
  conta           Conta    @relation(fields: [contaId], references: [id])
  id              String   @id @default(uuid())
  // "anthropic" | "gemini"
  provider        String   @default("anthropic")
  // Modelo usado quando provider=anthropic
  modeloAnthropic String   @default("claude-sonnet-4-6")
  // Modelo usado quando provider=gemini
  modeloGemini    String   @default("gemini-2.5-flash")
  // Agente conversacional ligado? Desligado = não gasta IA, responde aviso educado.
  // Nasce desligado de propósito: o número hoje serve só pra envios automáticos.
  ativo           Boolean  @default(false)
  // Resposta educada quando agente desligado; null = usa default do código.
  mensagemInativo String?  @db.Text
  alteradoEm      DateTime @updatedAt
  alteradoPor     User?    @relation(fields: [alteradoPorId], references: [id])
  alteradoPorId   String?

  @@unique([contaId])
  @@map("configuracao_agente")
}

/// Singleton (id="default"): aviso automático no grupo de WhatsApp quando um
/// motorista que já está no grupo se cadastra no app. Prova social numa
/// comunidade pequena e fechada (~45 membros). Desligado por padrão; admin
/// escolhe o grupo e ativa pelo dashboard.
model ConfiguracaoAvisoGrupo {
  contaId       String   @default("__SEM_CONTA__")
  conta         Conta    @relation(fields: [contaId], references: [id])
  id            String   @id @default(uuid())
  // Liga/desliga o disparo. Nasce desligado até o admin escolher o grupo.
  ativo         Boolean  @default(false)
  // JID do grupo destino (ex: "120363...@g.us"). Null = nada configurado.
  grupoJid      String?
  // Nome do grupo no momento da escolha — só pra exibir no painel.
  grupoNome     String?
  // Template da mensagem. `{nome}` é trocado pelo primeiro nome do motorista.
  // Null = usa o default do código.
  template      String?  @db.Text
  alteradoEm    DateTime @updatedAt
  alteradoPor   User?    @relation(fields: [alteradoPorId], references: [id])
  alteradoPorId String?

  @@unique([contaId])
  @@map("configuracao_aviso_grupo")
}

/// Singleton (id="default"): raios da busca de local de DESCARGA por GPS.
/// Busca em 2 etapas — tenta o raio inicial (apertado, pra nao confundir locais
/// proximos um do outro); se nao achar nada, tenta o ampliado e o app SUGERE o
/// resultado (nunca auto-seleciona). Ajustado pela operadora no dashboard.
model ConfiguracaoBuscaLocais {
  contaId              String   @default("__SEM_CONTA__")
  conta                Conta    @relation(fields: [contaId], references: [id])
  id                   String   @id @default(uuid())
  // Raio apertado da 1a tentativa (metros). 1 match aqui pode auto-selecionar.
  raioInicialM         Int      @default(50)
  // Raio da 2a tentativa quando o inicial nao acha nada (metros). So sugere.
  raioAmpliadoM        Int      @default(500)
  // Captura de GPS ao tocar "Estou no local de descarga":
  // alvo de precisao (m) que encerra a captura cedo; tempo maximo (s) que
  // amostra o GPS; e limite (m) acima do qual avisa "sinal fraco" e marca
  // a coordenada como suspeita no dashboard.
  gpsAlvoMetros        Int      @default(10)
  gpsMaxSegundos       Int      @default(20)
  gpsLimiteSinalFracoM Int      @default(50)
  alteradoEm           DateTime @updatedAt
  alteradoPor          User?    @relation(fields: [alteradoPorId], references: [id])
  alteradoPorId        String?

  @@unique([contaId])
  @@map("configuracao_busca_locais")
}

/// Singleton (id="default"): réguas da detecção de km atípico. Configurável
/// porque o limiar certo só aparece com dado real de produção — mudar não pode
/// exigir deploy da API nem OTA do app. O app recebe esta config embutida na
/// resposta de referência (§/m/km-referencia) pra aplicar a MESMA régua offline.
model ConfiguracaoKmAtipico {
  contaId          String   @default("__SEM_CONTA__")
  conta            Conta    @relation(fields: [contaId], references: [id])
  id               String   @id @default(uuid())
  /// Kill switch server-side: false = ninguém é avaliado nem avisado (o carimbo
  /// para de acontecer e o app não mostra nada). Não precisa de deploy.
  ativo            Boolean  @default(true)
  /// Desvio (%) vs. a mediana do histórico acima do qual o km é atípico.
  desvioPct        Int      @default(30)
  /// Desvio (%) vs. a rota calculada (fallback sem amostra). Deliberadamente mais
  /// frouxo que desvioPct: o OSRM não enxerga acesso de pedreira/portaria/estrada
  /// interna, então a mesma régua geraria enxurrada de falso positivo.
  desvioPctOsrm    Int      @default(50)
  /// Viagens comparáveis necessárias pra mediana valer como referência. Abaixo
  /// disso cai no OSRM.
  amostraMinima    Int      @default(5)
  /// Passado que ainda pesa na mediana. Limita o quanto uma rota que mudou de
  /// regime fica presa no que ela era.
  janelaDias       Int      @default(365)
  /// Abaixo disso não avalia: em viagem curta o desvio percentual estoura por
  /// arredondamento e não significa nada.
  kmMinimoAvaliado Decimal  @default(3) @db.Decimal(10, 2)
  alteradoEm       DateTime @updatedAt
  alteradoPor      User?    @relation(fields: [alteradoPorId], references: [id])
  alteradoPorId    String?

  @@unique([contaId])
  @@map("configuracao_km_atipico")
}

/// Força-atualização do app nativo (motorista-app). O backend aprende sozinho
/// a versão mais nova em circulação por plataforma (maior `Motorista.appVersion`
/// firmada em ≥N motoristas) e, conforme o `modo`, manda o app desatualizado
/// pra loja. `versaoMinima*` é override manual (opcional) — se setado, vence a
/// detecção automática (pros dois lados: forçar ou segurar).
model ConfiguracaoForcaAtualizacao {
  contaId             String   @default("__SEM_CONTA__")
  conta               Conta    @relation(fields: [contaId], references: [id])
  id                  String   @id @default(uuid())
  // off | observar | nudge | bloquear (ver MODOS_FORCA_ATUALIZACAO).
  // Default "observar": ao subir a migration NÃO bloqueia ninguém; o admin
  // liga o bloqueio no dashboard depois de conferir a versão detectada.
  modo                String   @default("observar")
  // Override manual da versão mínima exigida por plataforma. null = automático
  // (usa a maior versão detectada). Serve tanto pra forçar quanto pra segurar.
  versaoMinimaIos     String?
  versaoMinimaAndroid String?
  // Allowlist de teste: quando NÃO-vazia, só estes motoristas são avaliados
  // (todo o resto recebe "nenhuma"). Vazia = vale pra todos. Serve pra testar
  // o bloqueio em produção mirando só a própria conta, sem risco à frota.
  motoristasAlvo      String[] @default([])
  alteradoEm          DateTime @updatedAt
  alteradoPor         User?    @relation(fields: [alteradoPorId], references: [id])
  alteradoPorId       String?

  @@unique([contaId])
  @@map("configuracao_forca_atualizacao")
}

/// Campos disponíveis pra mapear no layout de importação de fechamento.
/// Substitui o enum hardcoded — admin pode cadastrar campos novos sem dev.
/// Campos `sistema=true` são embarcados no boot e não podem ser deletados.
model CampoLayout {
  contaId    String   @default("__SEM_CONTA__")
  conta      Conta    @relation(fields: [contaId], references: [id])
  id         String   @id @default(uuid())
  slug       String // identificador estável (lowercase, sem espaço)
  label      String // label amigável no dropdown
  ordem      Int      @default(100)
  ativo      Boolean  @default(true)
  // Sistema: embarcado no boot, slug e tipo travados, não pode deletar.
  sistema    Boolean  @default(false)
  // TEXTO | NUMERO | DATA — decorativo agora, pra futuro com comparação dinâmica
  tipo       String   @default("TEXTO")
  descricao  String?
  criadoEm   DateTime @default(now())
  alteradoEm DateTime @updatedAt

  @@unique([contaId, slug])
  @@index([ativo, ordem])
  @@index([contaId])
  @@map("campos_layout")
}

/// Log centralizado de erros do app móvel, dashboard e backend.
/// Cada ocorrência é uma row. Agrupamento por hash do stack trace
/// é feito em query (GROUP BY hash). Sem expurgo automático.
model ErrorLog {
  contaId        String?
  conta          Conta?    @relation(fields: [contaId], references: [id])
  id             String    @id @default(uuid())
  /// Hash sha256(message + stack normalizado) — agrupa erros idênticos
  hash           String
  /// Origem: 'motorista-app' | 'dashboard' | 'api'
  origem         String
  /// Mensagem curta do erro
  message        String    @db.Text
  /// Stack trace completo (pode ser ofuscado em prod)
  stack          String?   @db.Text
  /// Versão do app/release (commit SHA ou app version)
  versao         String?
  /// Quem estava logado (motorista, user admin)
  userId         String?
  userType       String?
  /// Rota / URL onde ocorreu
  url            String?
  /// User agent (web) ou device info (mobile)
  userAgent      String?
  /// Contexto extra: device specs, network, breadcrumbs, etc
  extra          Json?
  /// Marcado como corrigido por um admin — não bloqueia novos eventos do mesmo hash
  resolvido      Boolean   @default(false)
  resolvidoEm    DateTime?
  resolvidoPorId String?
  capturadoEm    DateTime  @default(now())

  @@index([hash])
  @@index([origem, capturadoEm])
  @@index([capturadoEm])
  @@index([userId])
  @@index([resolvido, capturadoEm])
  @@index([contaId])
  @@map("error_logs")
}

/// Telemetria de operação do motorista. Eventos semânticos (tipos enumerados)
/// pra investigar falhas silenciosas (rota não calculada, GPS falhou, viagem
/// salva offline, etc). Diferente de ErrorLog que captura crashes JS, aqui é
/// "isso aconteceu e queremos saber". Linkados a viagem (via id ou clientId)
/// quando aplicável. Reconciliação: quando viagem chega no backend, faz
/// UPDATE WHERE viagemClientId = ? AND viagemId IS NULL.
model EventoMotorista {
  contaId        String    @default("__SEM_CONTA__")
  conta          Conta     @relation(fields: [contaId], references: [id])
  id             String    @id // motorista gera uuid local (idempotência)
  motorista      Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  motoristaId    String
  viagem         Viagem?   @relation(fields: [viagemId], references: [id], onDelete: SetNull)
  viagemId       String?
  /// Pré-sync usa esse campo (viagem ainda não foi enviada). Após viagem
  /// criada no backend, reconciliação popula viagemId.
  viagemClientId String?
  /// Snake_case enumerado em shared-types (TipoEvento). Aceita string livre
  /// no banco pra permitir adicionar tipos novos sem migration.
  tipo           String
  /// Payload semântico (km, fonte, motivo, etc). Forma depende do tipo.
  contexto       Json
  online         Boolean
  versaoApp      String?
  /// 'motorista-app' | 'motorista-pwa'
  origem         String
  /// Timestamp do device quando o evento aconteceu.
  capturadoEm    DateTime
  recebidoEm     DateTime  @default(now())

  @@index([motoristaId, capturadoEm])
  @@index([viagemId, capturadoEm])
  @@index([viagemClientId, capturadoEm])
  @@index([tipo, capturadoEm])
  @@index([contaId])
  @@map("eventos_motorista")
}

model Abastecimento {
  contaId          String          @default("__SEM_CONTA__")
  conta            Conta           @relation(fields: [contaId], references: [id])
  id               String          @id @default(uuid())
  clientId         String          @unique // idempotência (gerado no app)
  motorista        Motorista       @relation(fields: [motoristaId], references: [id])
  motoristaId      String
  veiculo          Veiculo         @relation(fields: [veiculoId], references: [id])
  veiculoId        String
  empresa          Empresa?        @relation(fields: [empresaId], references: [id])
  empresaId        String?
  data             DateTime // timestamp completo (hora importa)
  tipo             TipoCombustivel @default(DIESEL_S10)
  litros           Decimal         @db.Decimal(8, 3)
  /// Null quando abastecimento em comboio (motorista não soube o valor na
  /// hora). Listagens e fechamentos lidam com null como "sem valor".
  valorTotal       Decimal?        @db.Decimal(10, 2)
  precoLitro       Decimal?        @db.Decimal(6, 3) // calculado server-side
  /// True quando o abastecimento foi no comboio: valor real será informado
  /// depois (admin pode editar). Distingue de "motorista esqueceu".
  emComboio        Boolean         @default(false)
  odometro         Int // km do hodômetro
  postoNome        String?
  tanqueCheio      Boolean         @default(true)
  observacao       String?
  // GPS capturado no momento do registro (silencioso — null se permissão negada)
  lat              Float?
  lng              Float?
  precisao         Float?
  criadoOfflineEm  DateTime?
  sincronizadoEm   DateTime        @default(now())
  alteradoEm       DateTime        @updatedAt
  /// Carimbada na criação — ver Viagem.transportadoraId. Não confundir com
  /// `empresaId` acima, que é o tomador que paga o abastecimento.
  transportadora   Transportadora? @relation(fields: [transportadoraId], references: [id], onDelete: SetNull)
  transportadoraId String?

  fotos            AbastecimentoFoto[]
  fechamentoLinhas FechamentoLinha[]

  @@index([veiculoId, data])
  @@index([motoristaId, data])
  @@index([empresaId, data])
  @@index([data])
  @@index([transportadoraId, data])
  @@index([contaId])
  @@index([contaId, data])
  @@map("abastecimentos")
}

model AbastecimentoFoto {
  contaId         String        @default("__SEM_CONTA__")
  conta           Conta         @relation(fields: [contaId], references: [id])
  id              String        @id @default(uuid())
  abastecimento   Abastecimento @relation(fields: [abastecimentoId], references: [id], onDelete: Cascade)
  abastecimentoId String
  storageKey      String // chave no MinIO
  /// Rotação aplicada via CSS na exibição admin. 0/90/180/270. Persistente.
  rotacao         Int           @default(0)
  capturadaEm     DateTime      @default(now())

  @@index([abastecimentoId])
  @@index([contaId])
  @@map("abastecimento_fotos")
}

enum NotificacaoEntregaStatus {
  PENDENTE
  ENTREGUE
  ERRO
}

/// Notificação enviada pelo admin (ou eventos futuros do sistema) pro motorista.
/// Persistida ANTES do envio pro Expo pra sobreviver a qualquer falha. App
/// busca via GET /m/notificacoes; push notification carrega o id no payload
/// pra fechar o loop "tap → marcar lida".
model Notificacao {
  contaId       String                   @default("__SEM_CONTA__")
  conta         Conta                    @relation(fields: [contaId], references: [id])
  id            String                   @id @default(uuid())
  motorista     Motorista                @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  motoristaId   String
  tipo          String // "mensagem-admin" hoje; outros tipos no futuro
  titulo        String
  corpo         String                   @db.Text
  dados         Json?
  lida          Boolean                  @default(false)
  lidaEm        DateTime?
  entregaStatus NotificacaoEntregaStatus @default(PENDENTE)
  entregaErro   String?
  expoTicketId  String?
  criadoPor     User?                    @relation("CriouNotificacao", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoPorId   String?
  criadoEm      DateTime                 @default(now())

  @@index([motoristaId, criadoEm(sort: Desc)])
  @@index([motoristaId, lida])
  @@index([contaId])
  @@map("notificacoes")
}

/// Execução do agente (Claude Code headless) sobre uma task do ClickUp,
/// disparada por webhook de Automation. É a FILA: persistida no banco de
/// propósito, pra reinício do serviço não perder item e pra dedupe/concorrência
/// valerem entre réplicas (memória do processo não serviria).
enum StatusExecucaoAgente {
  PENDENTE
  EXECUTANDO
  CONCLUIDA
  FALHOU
  EXCEDEU_LIMITE
}

model ExecucaoAgente {
  id        String               @id @default(uuid())
  /// Id da task no ClickUp (ex.: "86bb3pm4w").
  taskId    String
  /// Espelha taskId enquanto a execução está viva e vira null ao terminar. O
  /// @unique aqui é o que garante NO BANCO "uma execução ativa por task" — dois
  /// webhooks simultâneos brigam no índice, não numa checagem em memória.
  taskAtiva String?              @unique
  status    StatusExecucaoAgente @default(PENDENTE)
  /// Payload cru da Automation, pra auditoria e replay.
  payload   Json
  origemIp  String?

  tentativas         Int       @default(0)
  /// Só falha de INFRA reagenda (backoff). Falha do agente não retenta.
  proximaTentativaEm DateTime?
  /// Posse do worker: EXECUTANDO com reivindicadoEm velho volta pra fila
  /// (stale-recovery), senão processo morto no meio trava o item pra sempre.
  workerId           String?
  reivindicadoEm     DateTime?

  iniciadoEm        DateTime?
  finalizadoEm      DateTime?
  duracaoMs         Int?
  custoUsd          Decimal?  @db.Decimal(10, 4)
  exitCode          Int?
  branch            String?
  arquivosAlterados String[]  @default([])
  resumo            String?   @db.Text
  erro              String?   @db.Text
  /// Quando o comentário de volta na task foi publicado. Null com execução
  /// finalizada = ninguém foi avisado; é o pior resultado possível, então o
  /// worker loga como erro.
  comentadoEm       DateTime?

  criadoEm   DateTime @default(now())
  alteradoEm DateTime @updatedAt

  @@index([status, proximaTentativaEm])
  @@index([taskId, criadoEm(sort: Desc)])
  @@map("execucoes_agente")
}

// ─────────────────────────────────────────────────────────────────────────────
// Chat entre motoristas (estilo WhatsApp, dentro do app nativo).
//
// Escopo de propósito: só conversa 1:1 e um canal de Avisos da operação —
// sem grupos, sem status, sem chamada. Privacidade: o painel NÃO lê conversa
// de motorista com motorista; enxerga apenas o canal de Avisos (que ele mesmo
// escreve) e as mensagens que chegaram por denúncia.
// ─────────────────────────────────────────────────────────────────────────────

enum TipoConversa {
  /// 1:1 entre dois motoristas.
  DIRETA
  /// Canal da operação: admin escreve, motorista só lê. Um por instalação.
  AVISOS
}

enum TipoMensagemChat {
  TEXTO
  AUDIO
}

enum StatusDenunciaChat {
  ABERTA
  ARQUIVADA
  /// Mensagem removida pela operação (vira "removida por violar as regras").
  REMOVIDA
}

model Conversa {
  contaId     String       @default("__SEM_CONTA__")
  conta       Conta        @relation(fields: [contaId], references: [id])
  id          String       @id @default(uuid())
  tipo        TipoConversa @default(DIRETA)
  /// Chave canônica do par: os dois motoristaIds ordenados e juntados por ":".
  /// É o que garante UMA conversa por par mesmo com os dois celulares abrindo
  /// ao mesmo tempo — a corrida morre no unique do banco, não no código.
  /// Null no canal de Avisos (que é único por definição).
  chaveDireta String?      @unique
  criadoEm    DateTime     @default(now())

  /// Denormalizado só pra ordenar/pintar a lista de conversas sem varrer
  /// mensagens. Prévia já resolvida (áudio vira "Áudio 0:12").
  ultimaMensagemEm    DateTime?
  ultimaMensagemTexto String?   @db.Text

  participantes ConversaParticipante[]
  mensagens     MensagemChat[]

  @@index([ultimaMensagemEm(sort: Desc)])
  @@index([contaId])
  @@map("conversas")
}

/// Um motorista dentro de uma conversa. Guarda o estado de leitura dele —
/// contador denormalizado pra o badge não custar um count() por conversa.
model ConversaParticipante {
  contaId     String    @default("__SEM_CONTA__")
  conta       Conta     @relation(fields: [contaId], references: [id])
  id          String    @id @default(uuid())
  conversa    Conversa  @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  conversaId  String
  motorista   Motorista @relation("ParticipacoesChat", fields: [motoristaId], references: [id], onDelete: Cascade)
  motoristaId String

  naoLidas        Int       @default(0)
  ultimaLeituraEm DateTime?
  /// Motorista silenciou a conversa: continua recebendo, mas sem push.
  silenciado      Boolean   @default(false)
  criadoEm        DateTime  @default(now())

  @@unique([conversaId, motoristaId])
  @@index([motoristaId])
  @@index([contaId])
  @@map("conversa_participantes")
}

model MensagemChat {
  contaId    String   @default("__SEM_CONTA__")
  conta      Conta    @relation(fields: [contaId], references: [id])
  id         String   @id @default(uuid())
  /// UUID gerado no celular. É a idempotência do outbox: reenvio depois de
  /// timeout devolve a mensagem existente em vez de duplicar na conversa.
  clientId   String   @unique
  conversa   Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  conversaId String

  /// ADMIN só existe no canal de Avisos.
  autor       AutorMensagem
  motorista   Motorista?    @relation("MensagensChat", fields: [motoristaId], references: [id], onDelete: SetNull)
  motoristaId String?
  usuario     User?         @relation("MensagensChat", fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioId   String?
  /// Snapshot do nome do autor — sobrevive à exclusão do Motorista/User.
  autorNome   String

  tipo          TipoMensagemChat @default(TEXTO)
  texto         String?          @db.Text
  /// Fase 2 (áudio): chave no MinIO, duração e transcrição automática. A
  /// transcrição chega depois da mensagem (Whisper roda em background), então
  /// é sempre nullable — a bolha aparece na hora e o texto preenche em seguida.
  audioKey      String?
  audioSegundos Int?
  transcricao   String?          @db.Text

  criadoEm      DateTime  @default(now())
  /// Soft delete. Preenchido tanto por "apagar pra todos" do autor quanto por
  /// remoção da operação via denúncia; a bolha vira "mensagem apagada" e o
  /// conteúdo some da API. Nunca hard delete: denúncia precisa do histórico.
  apagadaEm     DateTime?
  /// Quem removeu, quando foi moderação (null quando foi o próprio autor).
  removidaPor   User?     @relation("RemoveuMensagemChat", fields: [removidaPorId], references: [id], onDelete: SetNull)
  removidaPorId String?

  denuncias DenunciaMensagemChat[]

  @@index([conversaId, criadoEm])
  @@index([contaId])
  @@map("mensagens_chat")
}

/// Bloqueio 1:1. Bloqueado não aparece na lista de contatos, não consegue
/// mandar mensagem, e a conversa some pros dois lados.
model BloqueioChat {
  contaId     String    @default("__SEM_CONTA__")
  conta       Conta     @relation(fields: [contaId], references: [id])
  id          String    @id @default(uuid())
  motorista   Motorista @relation("BloqueiosFeitos", fields: [motoristaId], references: [id], onDelete: Cascade)
  motoristaId String
  bloqueado   Motorista @relation("BloqueiosRecebidos", fields: [bloqueadoId], references: [id], onDelete: Cascade)
  bloqueadoId String
  criadoEm    DateTime  @default(now())

  @@unique([motoristaId, bloqueadoId])
  @@index([bloqueadoId])
  @@index([contaId])
  @@map("bloqueios_chat")
}

/// Denúncia de mensagem. Exigência de loja pra app com conteúdo entre usuários
/// (App Store 1.2), e o único caminho pelo qual uma conversa privada chega aos
/// olhos da operação.
model DenunciaMensagemChat {
  contaId       String       @default("__SEM_CONTA__")
  conta         Conta        @relation(fields: [contaId], references: [id])
  id            String       @id @default(uuid())
  mensagem      MensagemChat @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  mensagemId    String
  denunciante   Motorista    @relation("DenunciasChat", fields: [denuncianteId], references: [id], onDelete: Cascade)
  denuncianteId String
  motivo        String
  detalhe       String?      @db.Text

  status         StatusDenunciaChat @default(ABERTA)
  resolvidoPor   User?              @relation("ResolveuDenunciaChat", fields: [resolvidoPorId], references: [id], onDelete: SetNull)
  resolvidoPorId String?
  resolvidoEm    DateTime?
  criadoEm       DateTime           @default(now())

  @@unique([mensagemId, denuncianteId])
  @@index([status, criadoEm(sort: Desc)])
  @@index([contaId])
  @@map("denuncias_mensagem_chat")
}
