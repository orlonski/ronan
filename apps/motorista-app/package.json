{
  "name": "@ronan/motorista-app",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "build:android:preview": "eas build --local --platform android --profile preview",
    "build:android": "eas build --local --platform android --profile production",
    "build:ios:preview": "eas build --local --platform ios --profile preview",
    "build:ios": "eas build --local --platform ios --profile production",
    "ota:avisar": "node scripts/avisar-ota.mjs",
    "ota": "eas update --branch production && node scripts/avisar-ota.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "eas-build-post-install": "cd ../../packages/shared-types && pnpm build"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@hookform/resolvers": "^3.10.0",
    "@mapbox/polyline": "^1.2.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@ronan/shared-types": "workspace:*",
    "@tanstack/react-query": "^5.62.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~54.0.0",
    "expo-background-fetch": "~14.0.9",
    "expo-camera": "~17.0.0",
    "expo-constants": "~18.0.0",
    "expo-device": "~8.0.0",
    "expo-file-system": "~19.0.0",
    "expo-haptics": "~15.0.0",
    "expo-image-manipulator": "~14.0.0",
    "expo-image-picker": "~17.0.11",
    "expo-in-app-updates": "^0.12.0",
    "expo-linking": "~8.0.0",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.0",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.17",
    "lucide-react-native": "^0.469.0",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.54.2",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.2.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-nitro-image": "^0.15.1",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/config-plugins": "^55.0.8",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^22.10.0",
    "@types/react": "~19.1.17",
    "babel-preset-expo": "^55.0.19",
    "eslint-config-expo": "~10.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "clsx"
        ]
      }
    }
  }
}
