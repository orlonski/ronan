# Variáveis compartilhadas para docker-compose dev
POSTGRES_USER=ronan
POSTGRES_PASSWORD=ronan_dev
POSTGRES_DB=ronan
POSTGRES_PORT=5435

MINIO_ROOT_USER=ronan
MINIO_ROOT_PASSWORD=ronan_dev_secret
MINIO_BUCKET=ronan-tickets

# Nominatim adiado pra v2: import gigante (~30GB) inviabilizou no MVP.
# Geocoding atual = só ViaCEP (gratuito, sem container).

# API
API_PORT=3000
JWT_SECRET=change-me-dev
JWT_REFRESH_SECRET=change-me-dev-refresh

# Dashboard
DASHBOARD_PORT=3001
NEXTAUTH_SECRET=change-me-dev-nextauth
NEXT_PUBLIC_API_URL=http://localhost:3000

# Motorista
MOTORISTA_PORT=3002
VITE_API_URL=http://localhost:3000

# Runner de tasks do ClickUp (webhook de Automation → fila → agente → comentário).
# NASCE DESLIGADO: sem CLICKUP_RUNNER_TOKEN o webhook responde 401 e o worker
# não roda. Ver docs/clickup-runner.md.
CLICKUP_RUNNER_TOKEN=                  # segredo do header X-Runner-Token (obrigatório pra ligar)
CLICKUP_RUNNER_PATH_SEGREDO=           # opcional: segmento secreto no path (/<segredo>/clickup/task-ready)
CLICKUP_API_TOKEN=                     # token pessoal do ClickUp, pra comentar de volta na task
# CLICKUP_RUNNER_CONCORRENCIA=1        # execuções simultâneas (por task já é sempre 1)
# CLICKUP_RUNNER_JANELA_DEDUPE_MS=600000
# CLICKUP_RUNNER_TENTATIVAS_MAX=3      # só falha de INFRA retenta
# CLICKUP_RUNNER_TIMEOUT_MS=1800000    # teto por execução
# CLICKUP_RUNNER_ORCAMENTO_USD=5       # teto de gasto por execução
# CLICKUP_RUNNER_RATE_LIMIT=30         # requisições por minuto por IP
# CLICKUP_RUNNER_INTERVALO_MS=5000     # intervalo do loop do worker
