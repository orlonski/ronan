# ===== NextAuth (dashboard) =====
NEXTAUTH_SECRET=__GERAR_HEX_32__
NEXTAUTH_URL=https://painel.SEU-DOMINIO.com.br

# ===== URLs públicas =====
PUBLIC_API_URL=https://api.SEU-DOMINIO.com.br
CORS_ORIGINS=https://painel.SEU-DOMINIO.com.br,https://app.SEU-DOMINIO.com.br

# ===== Anthropic (IA de conciliação) =====
ANTHROPIC_API_KEY=sk-ant-api03-...

